# UConnect Environment Configuration
# Copy this file to .env and fill in your actual values
# For Render deployment: Add these as Environment Variables in Render Dashboard

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# For Render: Use MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/campus_connect
MONGODB_TEST_URI=mongodb://localhost:27017/campus_connect_test

# Security Keys (Generate strong random strings for production!)
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_32_characters
SESSION_SECRET=your_super_secure_session_secret_key_here_minimum_32_characters
# Optional: AES-256 key (base64) for encrypting temporary passwords stored in sessions.
# Generate one with: `openssl rand -base64 32` and set it in .env.
PASSWORD_SESSION_KEY=<BASE64_32_BYTE_KEY>

# ============================================
# EMAIL CONFIGURATION (IMPORTANT FOR RENDER!)
# ============================================
# For Gmail SMTP to work on Render/Cloud:
# 1. Use a Gmail account with 2-Step Verification ENABLED
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. The App Password is 16 characters (shown as: xxxx xxxx xxxx xxxx)
# 4. Enter it WITHOUT SPACES in EMAIL_PASS
#
# Example: If Google shows "abcd efgh ijkl mnop", use "abcdefghijklmnop"

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your16characterapppassword
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=UConnect Campus

# Skip email verification on startup (optional, set to 'true' if having issues)
# SKIP_EMAIL_VERIFY=true

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./public/uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Configuration
ADMIN_EMAIL=admin@campusconnect.edu
ADMIN_PASSWORD=SecureAdminPassword123!

# Redis (Optional - set SESSION_STORE=mongo if Redis unavailable on Render free tier)
REDIS_URL=redis://127.0.0.1:6379
SESSION_STORE=mongo