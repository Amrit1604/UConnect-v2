{
  "name": "campus-connect",
  "version": "1.0.0",
  "description": "A secure student-focused social media platform for campus communities",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "cert:generate": "node scripts/generate-self-signed-cert.js",
    "cert:generate:force": "node scripts/generate-self-signed-cert.js --force",
    "cert:mkcert": "mkcert -install && mkcert -cert-file certs/server.crt -key-file certs/server.key localhost 127.0.0.1 ::1",
    "cert:mkcert:generate": "npm run cert:mkcert || npm run cert:generate",
    "cert:mkcert:install": "mkcert -install",
    "cert:mkcert:force": "rm -f certs/* && mkcert -cert-file certs/server.crt -key-file certs/server.key localhost 127.0.0.1 ::1",
    "smoke:test": "node scripts/smokePostsTest.js",
    "test": "jest --coverage",
    "test:quick": "jest tests/basic.sanity.test.js --runInBand",
    "test:perf:session": "jest tests/session.performance.test.js --runInBand",
    "test:student": "jest tests/simple.studentChecks.test.js --runInBand",
    "test:student:exists": "jest tests/student.exists.test.js --runInBand",
    "test:student:password:presence": "jest tests/password.presence.test.js --runInBand",
    "test:student:password:hash": "jest tests/password.hash.test.js --runInBand",
    "test:student:username": "jest tests/username.format.test.js --runInBand",
    "test:student:email": "jest tests/email.domain.test.js --runInBand",
    "test:student:auth": "jest tests/auth.endpoints.test.js --runInBand",
    "test:student:db": "jest tests/db.completeness.test.js --runInBand",
    "test:student:all": "jest tests/student.exists.test.js tests/password.presence.test.js tests/password.hash.test.js tests/email.domain.test.js tests/username.format.test.js tests/auth.endpoints.test.js tests/db.completeness.test.js --runInBand",
    "lint": "eslint .",
    "seed": "node scripts/seedDatabase.js",
    "agent": "node scripts/agent.js"
  },
  "keywords": [
    "social-media",
    "campus",
    "students",
    "education",
    "secure"
  ],
  "author": "UConnect Team",
  "license": "MIT",
  "dependencies": {
    "redis": "^4.7.0",
    "connect-redis": "^7.1.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.0",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.0.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "method-override": "^3.0.0",
    "moment": "^2.29.4",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-gridfs-storage": "^5.0.2",
    "nodemailer": "^6.9.4",
    "sanitize-html": "^2.11.0",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^12.0.0"
  },
  "devDependencies": {
    "eslint": "^8.47.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amrit1604/UConnect-v2.git"
  },
  "bugs": {
    "url": "https://github.com/Amrit1604/UConnect-v2/issues"
  },
  "homepage": "https://github.com/Amrit1604/UConnect-v2#readme"
}
