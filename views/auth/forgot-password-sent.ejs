<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Sent | UConnect</title>
    <link href="/css/auth-neo.css" rel="stylesheet">
    <link href="/css/landing-neo.css" rel="stylesheet">
</head>

<body class="auth-page-neo">

    <div class="auth-bg-shapes">
        <div class="auth-bg-shape"></div>
        <div class="auth-bg-shape"></div>
        <div class="auth-bg-shape"></div>
    </div>

    <%- include('../partials/navbar-neo') %>

    <main class="main-content">
        <div class="auth-container-neo">
            <div class="auth-card-neo">
                <div class="auth-header-neo">
                    <span class="logo-icon-neo">📨</span>
                    <h2 class="auth-title-neo">CHECK YOUR EMAIL</h2>
                </div>

                <p class="auth-subtitle-neo">
                    If an account exists for <strong><%= email %></strong>, a password reset link has been sent.
                </p>

                <a href="/auth/login" class="btn-neo btn-primary-neo">
                    <span>🔐</span> BACK TO LOGIN
                </a>
            </div>
        </div>
    </main>
</body>
</html>
