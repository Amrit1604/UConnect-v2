<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | UConnect</title>
    <link href="/css/auth-neo.css" rel="stylesheet">
    <link href="/css/landing-neo.css" rel="stylesheet">
</head>

<body class="auth-page-neo">

    <div class="auth-bg-shapes">
        <div class="auth-bg-shape"></div>
        <div class="auth-bg-shape"></div>
        <div class="auth-bg-shape"></div>
    </div>

    <%- include('../partials/navbar') %>



    <main class="main-content">
        <div class="auth-container-neo">
            <div class="auth-card-neo">

                <div class="auth-header-neo">
                    <span class="logo-icon-neo">🔑</span>
                    <h2 class="auth-title-neo">SET NEW PASSWORD</h2>
                </div>

                <% if (errors && errors.length > 0) { %>
                    <div class="form-errors-neo">
                        <% errors.forEach(error => { %>
                            <div class="error-message-neo">
                                <span>⚠️</span>
                                <%= error.msg %>
                            </div>
                        <% }) %>
                    </div>
                <% } %>

                <% if (serverError) { %>
                    <div class="form-errors-neo">
                        <div class="error-message-neo">⚠️ <%= serverError %></div>
                    </div>
                <% } %>

                <form method="POST" action="/auth/reset-password/<%= token %>" novalidate>
                    <div class="form-group-neo">
                        <label class="form-label-neo">NEW PASSWORD</label>
                        <input type="password" name="password" id="password" class="form-input-neo" required>
                    </div>

                    <div class="form-group-neo">
                        <label class="form-label-neo">CONFIRM PASSWORD</label>
                        <input type="password" name="confirmPassword" id="confirmPassword" class="form-input-neo" required>
                    </div>

                    <button type="submit" class="btn-neo btn-primary-neo">
                        <span>✔️</span> UPDATE PASSWORD
                    </button>
                </form>

                <div class="auth-footer-neo">
                    <p>Back to login? <a href="/auth/login">Click here</a></p>
                </div>

            </div>
        </div>
    </main>
</body>
</html>
