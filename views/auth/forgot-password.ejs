<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | UConnect</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="/css/landing-neo.css" rel="stylesheet">
    <link href="/css/auth-neo.css" rel="stylesheet">
</head>

<body class="auth-page-neo">

    <!-- Background Animation -->
    <div class="auth-bg-shapes">
        <div class="auth-bg-shape"></div>
        <div class="auth-bg-shape"></div>
        <div class="auth-bg-shape"></div>
    </div>

    <!-- Navbar -->
    <%- include('../partials/navbar') %>

    <!-- Main Content -->
    <main class="main-content">
        <div class="auth-container-neo">
            <div class="auth-card-neo">

                <div class="auth-header-neo">
                    <div class="auth-logo-neo">
                        <span class="logo-icon-neo">📧</span>
                        <h1 class="logo-text-neo">RESET PASSWORD</h1>
                    </div>
                    <p class="auth-subtitle-neo">Enter your email to receive a reset link</p>
                </div>

                <!-- Errors -->
                <% if (errors && errors.length > 0) { %>
                    <div class="form-errors-neo">
                        <% errors.forEach(error => { %>
                            <div class="error-message-neo">
                                <span>⚠️</span>
                                <%= error.msg %>
                            </div>
                        <% }) %>
                    </div>
                <% } %>

                <% if (serverError) { %>
                    <div class="form-errors-neo">
                        <div class="error-message-neo">⚠️ <%= serverError %></div>
                    </div>
                <% } %>

                <form method="POST" action="/auth/forgot-password" novalidate>
                    <div class="form-group-neo">
                        <label for="email" class="form-label-neo">EMAIL</label>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            class="form-input-neo"
                            placeholder="email@university.edu"
                            value="<%= formData?.email || '' %>"
                            required
                        >
                    </div>

                    <button type="submit" class="btn-neo btn-primary-neo">
                        <span>📤</span> SEND RESET LINK
                    </button>
                </form>

                <div class="auth-footer-neo">
                    <p>Remember password? <a href="/auth/login">Back to Login</a></p>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/landing-neo.js"></script>
    <script src="/js/auth.js"></script>
</body>
</html>
