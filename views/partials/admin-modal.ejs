<div id="adminOverlay" class="admin-overlay" aria-hidden="true">
  <div id="adminModal" class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="admin-modal-title">
    <div class="admin-modal-inner">
      <h2 id="admin-modal-title" class="admin-modal-title">Admin Access</h2>
      <p class="admin-modal-sub">Enter admin password to continue.</p>
      <input id="adminPasswordInput" autocomplete="current-password" type="password" placeholder="Admin password" class="admin-input" />
      <div class="admin-actions">
        <button id="adminCancelBtn" class="admin-btn admin-btn-ghost" type="button">Cancel</button>
        <button id="adminLoginBtn" class="admin-btn admin-btn-primary" type="button">Unlock</button>
      </div>
      <div id="adminMsg" class="admin-msg"></div>
    </div>
  </div>
</div>
