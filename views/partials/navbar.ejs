<nav class="navbar">
    <div class="nav-container">
        <div class="nav-brand">
            <a href="/" class="brand-link">
                <span>🎓</span>
                <span>UConnect</span>
            </a>
        </div>

        <% if (user) { %>
            <!-- Authenticated Navigation -->
            <div class="nav-menu">
                <div class="nav-links">
                    <a href="/posts" class="nav-link <%= currentPath === '/posts' ? 'active' : '' %>">
                        <span>🏠</span>
                        <span>Feed</span>
                    </a>
                    <a href="/posts/create" class="nav-link <%= currentPath === '/posts/create' ? 'active' : '' %>">
                        <span>➕</span>
                        <span>Create</span>
                    </a>
                    <a href="/users/campus" class="nav-link <%= currentPath === '/users/campus' ? 'active' : '' %>">
                        <span>👥</span>
                        <span>Campus</span>
                    </a>
                    <% if (user.role === 'admin') { %>
                        <a href="/admin" class="nav-link <%= currentPath.startsWith('/admin') ? 'active' : '' %>">
                            <span>🛡️</span>
                            <span>Admin</span>
                        </a>
                    <% } %>
                </div>

                <!-- Theme Toggle -->
                <button class="theme-toggle" type="button" data-theme-toggle="landing" aria-label="Toggle theme" aria-pressed="false" title="Toggle theme">
                    <span aria-hidden="true" data-theme-icon>🌙</span>
                </button>

                <!-- User Menu -->
                <div class="user-menu">
                    <div class="user-dropdown">
                        <button class="user-btn" type="button" aria-haspopup="true" aria-expanded="false">
                            <img src="<%= user.avatarUrl %>"
                                 alt="@<%= user.username %>" class="user-avatar">
                            <span class="user-name">@<%= user.username %></span>
                            <span>▼</span>
                        </button>
                        <div class="dropdown-menu" id="userDropdown">
                            <a href="/users/profile" class="dropdown-item">
                                <span>👤</span>
                                My Profile
                            </a>
                            <a href="/users/settings/profile" class="dropdown-item">
                                <span>⚙️</span>
                                Settings
                            </a>
                            <div class="dropdown-divider"></div>
                            <a href="/auth/logout" class="dropdown-item">
                                <span>🚪</span>
                                Logout
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Menu Toggle -->
            <button class="mobile-menu-btn" type="button" aria-controls="mobileMenu" aria-expanded="false" data-menu-open-icon="✖" data-menu-closed-icon="☰">
                <span aria-hidden="true" data-menu-icon>☰</span>
            </button>
        <% } else { %>
            <!-- Guest Navigation -->
            <div class="nav-menu">
                <div class="nav-links">
                    <button class="theme-toggle" type="button" data-theme-toggle="landing" aria-label="Toggle theme" aria-pressed="false" title="Toggle theme">
                        <span aria-hidden="true" data-theme-icon>🌙</span>
                    </button>
                    <a href="/auth/login" class="nav-link">Login</a>
                    <a href="/auth/register" class="btn btn-primary">Join Now</a>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Mobile Menu -->
    <% if (user) { %>
        <div class="mobile-menu" id="mobileMenu">
            <a href="/posts" class="mobile-menu-item">
                <span>🏠</span>
                Feed
            </a>
            <a href="/posts/create" class="mobile-menu-item">
                <span>➕</span>
                Create Post
            </a>
            <a href="/users/campus" class="mobile-menu-item">
                <span>👥</span>
                Campus Users
            </a>
            <a href="/users/profile" class="mobile-menu-item">
                <span>👤</span>
                My Profile
            </a>
            <a href="/users/settings/profile" class="mobile-menu-item">
                <span>⚙️</span>
                Settings
            </a>
            <button class="mobile-menu-item theme-toggle-mobile" type="button" data-theme-toggle="landing" aria-label="Toggle theme" aria-pressed="false">
                <span aria-hidden="true" data-theme-icon>🌙</span>
                Toggle Theme
            </button>
            <% if (user.role === 'admin') { %>
                <a href="/admin" class="mobile-menu-item">
                    <span>🛡️</span>
                    Admin Panel
                </a>
            <% } %>
            <div class="mobile-menu-divider"></div>
            <a href="/auth/logout" class="mobile-menu-item">
                <span>🚪</span>
                Logout
            </a>
        </div>
    <% } %>
</nav>