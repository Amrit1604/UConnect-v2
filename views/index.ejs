                            <div class="demo-info card-info">
                                <span class="demo-name">Gurmanpreet Singh</span>
                                <span class="demo-campus">Student Council</span>
                            </div>
                        </div>
                        <p class="demo-content card-content">Study group for Data Structures - Library 3rd floor, everyday at 5 PM 📚</p>
                        <div class="demo-actions card-stats">
