<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | UConnect</title>

    <!-- Meta tags for SEO -->
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Connect with your campus community. Share, discover, and engage with fellow students.' %>">
    <meta name="keywords" content="campus, students, social media, university, college, community">
    <meta name="author" content="UConnect">

    <!-- Open Graph tags -->
    <meta property="og:title" content="<%= title %> | UConnect">
    <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Connect with your campus community' %>">
    <meta property="og:type" content="website">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">

    <!-- CSS -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Open+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link href="/css/main.css" rel="stylesheet">
    <link href="/css/landing.css" rel="stylesheet">

    <!-- Floating Cards CSS -->
    <style>
        /* Hero Section Container */
        .hero {
            position: relative;
            min-height: 100vh;
            overflow: visible;
            display: flex;
            align-items: center;
            justify-content: center; /* Center the hero content */
        }

        .hero-container {
            position: relative;
            z-index: 1;
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Video section (below hero) */
        .video-section {
            background: var(--surface-color);
            padding: 0;
        }
        .video-container {
            padding: 0;
            max-width: none;
            margin: 0;
        }
        .video-wrapper {
            position: relative;
            width: 90vw;
            max-width: 1200px;
            left: 50%;
            transform: translateX(-50%);
            aspect-ratio: 16 / 9;
            overflow: hidden;
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--border-light);
        }
        .video-wrapper video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* 3D Cards */
        .hero-visual {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            perspective: 1000px;
            pointer-events: none;
            z-index: 10;
            display: block !important; /* Override landing.css hiding */
        }

        .floating-cards {
            position: relative;
            width: 100%;
            height: 100%;
        }

        .floating-cards .card-3d {
            pointer-events: auto;
        }

        .card-3d {
            position: absolute;
            width: 320px;
            padding: 1.5rem;
            background: var(--surface-color);
            backdrop-filter: blur(15px);
            border: 1px solid var(--border-light);
            border-radius: 20px;
            transition: all 0.5s ease;
            cursor: pointer;
            box-shadow: var(--card-shadow);
        }

        [data-theme='dark'] .card-3d {
            background: var(--surface-color);
            border: 1px solid var(--border-light);
            box-shadow: var(--card-shadow);
        }

        .card-3d:hover {
            transform: translateY(-8px) rotateY(-5deg);
            box-shadow: var(--card-hover-shadow);
            background: var(--card-hover-bg);
            border-color: var(--card-hover-border);
        }

        .card1 {
            top: 15%;
            left: 50px;
            z-index: 103;
            animation: float-card 4s ease-in-out infinite;
        }

        .card2 {
            top: 10%;
            right: 50px;
            z-index: 102;
            animation: float-card 4s ease-in-out infinite 1s;
        }

        .card3 {
            bottom: 25%;
            left: 50px;
            z-index: 101;
            animation: float-card 4s ease-in-out infinite 2s;
        }

        .card4 {
            bottom: 20%;
            right: 50px;
            z-index: 104;
            animation: float-card 4s ease-in-out infinite 3s;
        }

        @keyframes float-card {
            0%, 100% {
                transform: translateY(0) rotateY(2deg);
            }
            50% {
                transform: translateY(-15px) rotateY(-2deg);
            }
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1rem;
        }

        .avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: white;
            font-size: 1rem;
            box-shadow: 0 4px 12px rgba(var(--primary-color), 0.3);
        }

        .card-info h4, .demo-name {
            font-size: 0.95rem;
            margin-bottom: 2px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .card-info span, .demo-campus {
            font-size: 0.8rem;
            color: var(--text-secondary);
        }

        .card-content, .demo-content {
            color: var(--text-secondary);
            line-height: 1.5;
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }

        .card-stats, .demo-actions {
            display: flex;
            gap: 1.5rem;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .card-stats span, .demo-actions span {
            display: flex;
            align-items: center;
            gap: 5px;
            transition: color 0.3s ease;
        }

        .card-stats span:hover, .demo-actions span:hover {
            color: var(--primary-color);
        }

        /* Responsive adjustments */
        @media (max-width: 1400px) {
            .card1, .card3 {
                left: 30px;
            }

            .card2, .card4 {
                right: 30px;
            }
        }

        @media (max-width: 1200px) {
            .card1, .card3 {
                left: 20px;
            }

            .card2, .card4 {
                right: 20px;
            }
        }

        @media (max-width: 968px) {
            .hero {
                padding: 0 2rem;
            }

            .hero-visual {
                display: none !important;
            }
        }

        @media (max-width: 640px) {
            .card-3d {
                width: 100%;
                max-width: 300px;
            }
        }

        /* Add glow effect on hover */
        .card-3d::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(var(--primary-color), 0.1), rgba(var(--primary-light), 0.1));
            border-radius: 20px;
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }

        .card-3d:hover::before {
            opacity: 1;
        }
    </style>
</head>
<body class="landing-page">
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
<div class="nav-brand">
    <a href="/" class="brand-link">
        <img src="/images/logo.png" alt="UConnect Logo" style="width: 70px; height: 60px;" />
        <span>UConnect</span>
    </a>
</div>


            <% if (user) { %>
                <!-- Authenticated Navigation -->
                <div class="nav-menu">
                    <div class="nav-links">
                        <a href="/posts" class="nav-link">
                            🏠
                            <span>Feed</span>
                        </a>
                        <a href="/posts/create" class="nav-link">
                            ➕
                            <span>Create</span>
                        </a>
                        <a href="/users/campus" class="nav-link">
                            👥
                            <span>Campus</span>
                        </a>
                        <% if (user.role === 'admin') { %>
                            <a href="/admin" class="nav-link">
                                🛡️
                                <span>Admin</span>
                            </a>
                        <% } %>
                    </div>

                    <!-- Theme Toggle (Desktop) -->
                    <button class="theme-toggle" type="button" data-theme-toggle="landing" aria-label="Toggle theme" aria-pressed="false" title="Switch between light and dark themes">
                        <span aria-hidden="true" data-theme-icon>🌙</span>
                    </button>

                    <!-- User Menu -->
                    <div class="user-menu">
                        <div class="user-dropdown">
                            <button class="user-btn" type="button" aria-haspopup="true" aria-expanded="false">
                                <img src="<%= user.avatar ? '/uploads/avatars/' + user.avatar : '/images/default-avatar.png' %>"
                                     alt="<%= user.displayName %>" class="user-avatar">
                                <span class="user-name"><%= user.displayName %></span>
                                ⬇️
                            </button>
                            <div class="dropdown-menu" id="userDropdown">
                                <a href="/users/profile" class="dropdown-item">
                                    👤
                                    My Profile
                                </a>
                                <a href="/users/settings/profile" class="dropdown-item">
                                    ⚙️
                                    Settings
                                </a>
                                <div class="dropdown-divider"></div>
                                <a href="/auth/logout" class="dropdown-item">
                                    🚪
                                    Logout
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mobile Menu Toggle -->
                <button class="mobile-menu-btn" type="button" aria-controls="mobileMenu" aria-expanded="false" data-menu-open-icon="✖" data-menu-closed-icon="☰">
                    <span aria-hidden="true" data-menu-icon>☰</span>
                </button>
            <% } else { %>
                <!-- Guest Navigation -->
                <div class="nav-menu">
                    <div class="nav-links">
                        <a href="/auth/login" class="nav-link">Login</a>
                        <a href="/auth/register" class="btn btn-primary">Join Now</a>
                    </div>
                    <!-- Theme Toggle (Desktop) -->
                    <button class="theme-toggle" type="button" data-theme-toggle="landing" aria-label="Toggle theme" aria-pressed="false">
                        <span aria-hidden="true" data-theme-icon>🌙</span>
                    </button>
                </div>
            <% } %>
        </div>

        <!-- Mobile Menu -->
        <% if (user) { %>
            <div class="mobile-menu" id="mobileMenu">
                <a href="/posts" class="mobile-menu-item">
                    🏠
                    Feed
                </a>
                <a href="/posts/create" class="mobile-menu-item">
                    ➕
                    Create Post
                </a>
                <a href="/users/campus" class="mobile-menu-item">
                    👥
                    Campus Users
                </a>
                <a href="/users/profile" class="mobile-menu-item">
                    👤
                    My Profile
                </a>
                <a href="/users/settings/profile" class="mobile-menu-item">
                    ⚙️
                    Settings
                </a>
                <% if (user.role === 'admin') { %>
                    <a href="/admin" class="mobile-menu-item">
                        🛡️
                        Admin Panel
                    </a>
                <% } %>
                <div class="mobile-menu-divider"></div>
                <a href="/auth/logout" class="mobile-menu-item">
                    🚪
                    Logout
                </a>
            </div>
        <% } %>
    </nav>

    <!-- Flash Messages -->
    <% if (messages && (messages.success || messages.error || messages.warning || messages.info)) { %>
        <div class="flash-messages">
            <% if (messages.success) { %>
                <% messages.success.forEach(message => { %>
                    <div class="flash-message flash-success">
                        ✅
                        <span><%= message %></span>
                        <button class="flash-close" type="button" aria-label="Dismiss message">
                            ❌
                        </button>
                    </div>
                <% }) %>
            <% } %>

            <% if (messages.error) { %>
                <% messages.error.forEach(message => { %>
                    <div class="flash-message flash-error">
                        ⚠️
                        <span><%= message %></span>
                        <button class="flash-close" type="button" aria-label="Dismiss message">
                            ❌
                        </button>
                    </div>
                <% }) %>
            <% } %>

            <% if (messages.warning) { %>
                <% messages.warning.forEach(message => { %>
                    <div class="flash-message flash-warning">
                        ⚠️
                        <span><%= message %></span>
                        <button class="flash-close" type="button" aria-label="Dismiss message">
                            ❌
                        </button>
                    </div>
                <% }) %>
            <% } %>

            <% if (messages.info) { %>
                <% messages.info.forEach(message => { %>
                    <div class="flash-message flash-info">
                        ℹ️
                        <span><%= message %></span>
                        <button class="flash-close" type="button" aria-label="Dismiss message">
                            ❌
                        </button>
                    </div>
                <% }) %>
            <% } %>
        </div>
    <% } %>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Hero Section -->
        <section class="hero">
            <div class="hero-container">
                <div class="hero-content">
