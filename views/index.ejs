            <div class="footer-content">
                <div class="footer-section">
                    <h4>UConnect</h4>
                    <p>Connecting students across campuses, fostering community and collaboration.</p>
                </div>
                <div class="footer-section">
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="/auth/register">Join Now</a></li>
                        <li><a href="/auth/login">Sign In</a></li>
