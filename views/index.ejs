                        </div>
                    </div>
                </div>
            </div>

            <!-- Floating Cards -->
            <div class="hero-visual">
                <div class="hero-cards floating-cards">
                    <div class="demo-card card-3d card1">
                        <div class="demo-user card-header">
                            <img src="/images/demo-avatar-1.png" alt="Student" class="demo-avatar avatar">
                            <div class="demo-info card-info">
                                <span class="demo-name">Amrit Joshi</span>
                                <span class="demo-campus">Chitkara University</span>
                            </div>
                        </div>
