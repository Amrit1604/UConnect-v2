<!-- Neo Feed - Brutalist + Apple Design -->
<div class="posts-page">
    <!-- Background Effects (Same as index2.ejs) -->
    <div class="parallax-bg">
        <div class="parallax-layer layer-1"></div>
        <div class="parallax-layer layer-2"></div>
        <div class="blob-container">
            <div class="blob blob-1"></div>
            <div class="blob blob-2"></div>
            <div class="blob blob-3"></div>
        </div>
    </div>

    <!-- Floating Emoji Reactions -->
    <div class="emoji-reactions">
        <div class="emoji-float emoji-1">😂</div>
        <div class="emoji-float emoji-2">❤️</div>
        <div class="emoji-float emoji-3">🔥</div>
        <div class="emoji-float emoji-4">😢</div>
        <div class="emoji-float emoji-5">😡</div>
        <div class="emoji-float emoji-6">👍</div>
        <div class="emoji-float emoji-7">🎉</div>
    </div>

    <!-- Main Feed Container -->
    <div class="feed-layout-neo">
        <!-- Left Sidebar - Profile Only -->
        <aside class="feed-sidebar-left">
            <!-- User Profile Card -->
            <div class="profile-card-neo">
                <div class="profile-header-neo">
                    <%
                    // Use the precomputed avatarUrl (from virtual) or fallback to default
                    const avatarUrl = user.avatarUrl || '/images/default-avatar.png';
                    %>
                    <img src="<%= avatarUrl %>"
                         alt="<%= user.name %>"
                         class="profile-avatar-neo"
                         onerror="this.src='/images/default-avatar.png'">
                    <div class="profile-info-neo">
                        <h3 class="profile-name-neo"><%= user.name %></h3>
                        <p class="profile-username-neo">@<%= user.username %></p>
                        <p class="profile-campus-neo">🏫 <%= user.campus || 'Campus' %></p>
                    </div>
                </div>
                <div class="profile-stats-neo">
                    <div class="stat-item-neo">
                        <span class="stat-value-neo"><%= stats.totalPosts || 0 %></span>
                        <span class="stat-label-neo">POSTS</span>
                    </div>
                    <div class="stat-item-neo">
                        <span class="stat-value-neo"><%= stats.totalLikes || 0 %></span>
                        <span class="stat-label-neo">LIKES</span>
                    </div>
                    <div class="stat-item-neo">
                        <span class="stat-value-neo"><%= stats.totalComments || 0 %></span>
                        <span class="stat-label-neo">COMMENTS</span>
                    </div>
                </div>
                <a href="/posts/create" class="create-post-btn-neo">
                    ✨ CREATE POST
                </a>
            </div>

            <!-- Who to Follow -->
            <div class="trending-card-neo" id="whoToFollow" style="margin-top:16px;">
              <h3 class="card-title-neo">👥 WHO TO FOLLOW</h3>
              <div id="followSuggestions" class="trending-list-neo">
                <p class="trending-empty">Loading...</p>
              </div>
            </div>
        </aside>

        <!-- Main Feed -->
        <main class="feed-main-neo">
            <!-- Category Filters with Quick Links Button -->
            <div class="categories-bar-neo">
                <a href="/posts?category=all" class="category-chip-neo <%= !category || category === 'all' ? 'active' : '' %>">
                    🌐 ALL
                </a>
                <a href="/posts?category=lost-found" class="category-chip-neo <%= category === 'lost-found' ? 'active' : '' %>">
                    🔍 LOST & FOUND
                </a>
                <a href="/posts?category=events" class="category-chip-neo <%= category === 'events' ? 'active' : '' %>">
                    🎉 EVENTS
                </a>
                <a href="/posts?category=academics" class="category-chip-neo <%= category === 'academics' ? 'active' : '' %>">
                    🎓 ACADEMICS
                </a>
                <a href="/posts?category=sports" class="category-chip-neo <%= category === 'sports' ? 'active' : '' %>">
                    ⚽ SPORTS
                </a>
                <a href="/posts?category=canteen" class="category-chip-neo <%= category === 'canteen' ? 'active' : '' %>">
                    🍕 CANTEEN
                </a>
            </div>

            <!-- Posts Feed -->
            <% if (posts && posts.length > 0) { %>
                <div class="posts-grid-neo">
                    <% posts.forEach(post => { %>
                        <% if (post && post.author) { %>
                        <article class="post-card-neo" data-post-id="<%= post._id %>">
                            <!-- Post Header -->
                            <header class="post-header-neo">
                                <a href="/users/<%= post.author.username %>" class="post-author-neo" style="text-decoration:none;color:inherit;display:flex;align-items:center;gap:10px;">
                                    <%
                                                                        let postAuthorAvatar = post.author.avatarUrl || '/images/default-avatar.png';
                                                                        const isDicebearAvatar = typeof postAuthorAvatar === 'string' && postAuthorAvatar.includes('api.dicebear.com');
                                                                        const authorCacheKey = post.author.updatedAt ? new Date(post.author.updatedAt).getTime() : '';
                                                                        const postAuthorAvatarSrc = (!isDicebearAvatar && authorCacheKey)
                                                                            ? (postAuthorAvatar + (postAuthorAvatar.includes('?') ? '&' : '?') + 'v=' + authorCacheKey)
                                                                            : postAuthorAvatar;
                                    %>
                                    <span class="author-link-neo" data-username="<%= post.author.username %>" title="View @<%= post.author.username %>'s profile">
                                                                            <img src="<%= postAuthorAvatarSrc %>"
                                           alt="<%= post.author.username %>"
                                           class="author-avatar-neo"
                                           onerror="this.src='/images/default-avatar.png'">
                                    </span>
                                    <div class="author-info-neo">
                                        <a href="/users/<%= post.author.username %>" class="author-name-neo author-link-neo" data-username="<%= post.author.username %>">@<%= post.author.username %></a>
                                        <span class="post-time-neo">
                                            <%= new Date(post.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                        </span>
                                    </div>
                                </a>
                                <% if (post.category) { %>
                                    <span class="post-category-badge-neo"><%= post.category.toUpperCase() %></span>
                                <% } %>
                            </header>

                            <!-- Post Content -->
                            <div class="post-content-neo">
                                <% if (post.title) { %>
                                    <h2 class="post-title-neo"><%= post.title %></h2>
                                <% } %>
                                <% if (post.content) { %>
                                    <p class="post-text-neo"><%= post.content.substring(0, 200) %><%= post.content.length > 200 ? '...' : '' %></p>
                                <% } %>

                                <!-- Post Media -->
                                <% if (post.images && post.images.length > 0) { %>
                                    <div class="post-media-neo">
                                        <%
                                        let imgSrc = '';
                                        const img = post.images[0];
                                        if (img.url) {
                                            imgSrc = img.url;
                                        } else if (img.filename) {
                                            imgSrc = '/uploads/posts/' + img.filename;
                                        } else if (typeof img === 'string') {
                                            imgSrc = '/uploads/posts/' + img;
                                        }
                                        %>
                                        <img src="<%= imgSrc %>"
                                             alt="<%= img.originalName || 'Post image' %>"
                                             class="post-image-neo"
                                             loading="lazy"
                                             onerror="this.src='/images/default-avatar.png'; this.onerror=null;">
                                    </div>
                                <% } else if (post.media && post.media.length > 0) { %>
                                    <% const firstMedia = post.media[0]; %>
                                    <% if (firstMedia.type === 'image') { %>
                                        <div class="post-media-neo">
                                            <img src="<%= firstMedia.url || '/uploads/posts/' + firstMedia.filename %>"
                                                 alt="<%= firstMedia.originalName || 'Post image' %>"
                                                 class="post-image-neo"
                                                 loading="lazy"
                                                 onerror="this.src='/images/default-avatar.png'; this.onerror=null;">
                                        </div>
                                    <% } else if (firstMedia.type === 'video') { %>
                                        <div class="post-media-neo">
                                            <video class="post-video-neo" controls playsinline preload="metadata">
                                                <source src="<%= firstMedia.url %>"
                                                        type="<%= firstMedia.mimetype || 'video/mp4' %>">
                                                Your browser does not support the video tag.
                                            </video>
                                        </div>
                                    <% } %>
                                <% } else if (post.videos && post.videos.length > 0) { %>
                                    <div class="post-media-neo">
                                        <%
                                        let vidSrc = '';
                                        const vid = post.videos[0];
                                        if (vid.url) {
                                            vidSrc = vid.url;
                                        } else if (vid.filename) {
                                            vidSrc = '/uploads/posts/' + vid.filename;
                                        } else if (typeof vid === 'string') {
                                            vidSrc = '/uploads/posts/' + vid;
                                        }
                                        %>
                                        <video class="post-video-neo" controls playsinline preload="metadata">
                                            <source src="<%= vidSrc %>" type="<%= vid.mimetype || 'video/mp4' %>">
                                            Your browser does not support the video tag.
                                        </video>
                                    </div>
                                <% } %>

                                <!-- Tags -->
                                <% if (post.tags && post.tags.length > 0) { %>
                                    <div class="post-tags-neo">
                                        <% post.tags.slice(0, 3).forEach(tag => { %>
                                            <span class="tag-chip-neo">#<%= tag %></span>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Post Actions -->
                            <footer class="post-actions-neo">
                                <button class="action-btn-neo like-btn <%= post.likes && post.likes.includes(user._id.toString()) ? 'liked' : '' %>"
                                        data-action="like"
                                        data-post-id="<%= post._id %>">
                                    <span class="action-icon">❤️</span>
                                    <span class="action-count"><%= post.likes ? post.likes.length : 0 %></span>
                                </button>
                                <button class="action-btn-neo comment-btn" data-action="comment">
                                    <span class="action-icon">💬</span>
                                    <span class="action-count"><%= post.comments ? post.comments.length : 0 %></span>
                                </button>
                                <button class="action-btn-neo share-btn" data-post-id="<%= post._id %>" data-action="share">
                                    <span class="action-icon">🔗</span>
                                    <span class="action-text">SHARE</span>
                                </button>
                                <a href="/posts/<%= post._id %>" class="action-btn-neo view-btn">
                                    <span class="action-icon">👁️</span>
                                    <span class="action-text">VIEW</span>
                                </a>
                            </footer>

                            <!-- Quick Comment Section (Initially Hidden) -->
                            <div class="quick-comment-section" style="display: none;">
                                <form class="quick-comment-form" data-post-id="<%= post._id %>">
                                    <input type="text"
                                           class="quick-comment-input"
                                           placeholder="Add a comment..."
                                           required>
                                    <button type="submit" class="quick-comment-submit">POST</button>
                                </form>

                                <% if (post.comments && post.comments.length > 0) { %>
                                    <div class="quick-comments-list">
                                        <% post.comments.slice(0, 2).forEach(comment => { %>
                                            <% if (comment && comment.author) { %>
                                                <div class="quick-comment-item">
                                                    <a href="/users/<%= comment.author.username %>" class="author-link-neo" data-username="<%= comment.author.username %>" title="View @<%= comment.author.username %>" style="display:inline-flex;align-items:center;gap:8px;text-decoration:none;color:inherit;">
                                                      <%
                                                                                                                const commentAvatarBase = (comment.author.avatarUrl || '/images/default-avatar.png');
                                                                                                                const isDicebearCommentAvatar = typeof commentAvatarBase === 'string' && commentAvatarBase.includes('api.dicebear.com');
                                                                                                                const commentAvatarVer = comment.author.updatedAt ? new Date(comment.author.updatedAt).getTime() : '';
                                                                                                                const commentAvatarSrc = (!isDicebearCommentAvatar && commentAvatarVer)
                                                                                                                    ? (commentAvatarBase + (commentAvatarBase.includes('?') ? '&' : '?') + 'v=' + commentAvatarVer)
                                                                                                                    : commentAvatarBase;
                                                      %>
                                                      <img src="<%= commentAvatarSrc %>"
                                                           alt="<%= comment.author.username %>"
                                                           class="quick-comment-avatar">
                                                    </a>
                                                    <div class="quick-comment-content">
                                                        <a href="/users/<%= comment.author.username %>" class="author-link-neo" data-username="<%= comment.author.username %>" style="font-weight:600;color:inherit;text-decoration:none;">@<%= comment.author.username %></a>
                                                        <p><%= comment.content %></p>
                                                    </div>
                                                </div>
                                            <% } %>
                                        <% }); %>
                                        <% if (post.comments.length > 2) { %>
                                            <a href="/posts/<%= post._id %>" class="view-all-comments">
                                                View all <%= post.comments.length %> comments
                                            </a>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        </article>
                        <% } %>
                    <% }); %>
                </div>
            <% } else { %>
                <!-- Empty State -->
                <div class="empty-state-neo">
                    <div class="empty-icon-neo">📭</div>
                    <h3 class="empty-title-neo">NO POSTS YET</h3>
                    <p class="empty-text-neo">Be the first to share something with your campus!</p>
                    <a href="/posts/create" class="empty-btn-neo">CREATE FIRST POST</a>
                </div>
            <% } %>

            <!-- Load More Button -->
            <% if (posts && posts.length >= 20) { %>
                <div class="load-more-container">
                    <button class="load-more-btn-neo" data-page="<%= page + 1 %>">
                        LOAD MORE POSTS
                    </button>
                </div>
            <% } %>
        </main>

        <!-- Right Sidebar (Hidden on mobile, toggle with button) -->
        <aside class="feed-sidebar-right" id="quickLinksPanel">
            <!-- Close Button for Mobile -->
            <button class="close-panel-btn" id="closePanelBtn">✕</button>

            <!-- Mobile Profile Quick Access -->
            <div class="mobile-profile-section">
                <a href="/users/profile" class="mobile-profile-link">
                    <% 
                    let mobileAvatarUrl = '/images/default-avatar.png';
                    if (user.avatarType === 'upload' && user.avatar) {
                        mobileAvatarUrl = '/uploads/avatars/' + user.avatar;
                    } else if (user.avatarUrl) {
                        mobileAvatarUrl = user.avatarUrl;
                    }
                    %>
                    <img src="<%= mobileAvatarUrl %>" alt="<%= user.name %>" class="mobile-profile-avatar" onerror="this.src='/images/default-avatar.png'">
                    <div class="mobile-profile-info">
                        <h4 class="mobile-profile-name"><%= user.name %></h4>
                        <p class="mobile-profile-username">@<%= user.username %></p>
                    </div>
                </a>
                <div style="display: flex; gap: 8px; margin-top: 12px;">
                    <a href="/posts/create" class="mobile-create-post-btn" style="flex: 1;">✨ CREATE POST</a>
                    <a href="/auth/logout" class="mobile-logout-btn" style="flex: 1;">🚪 LOGOUT</a>
                </div>
            </div>

            <!-- Trending Tags -->
            <div class="trending-card-neo">
                <h3 class="card-title-neo">🔥 TRENDING</h3>
                <div class="trending-list-neo">
                    <% if (typeof trendingTags !== 'undefined' && trendingTags && trendingTags.length > 0) { %>
                        <% trendingTags.slice(0, 5).forEach(tag => { %>
                            <a href="/posts?tag=<%= tag %>" class="trending-item-neo">
                                <span class="trending-tag">#<%= tag %></span>
                                <span class="trending-arrow">→</span>
                            </a>
                        <% }); %>
                    <% } else { %>
                        <p class="trending-empty">No trending tags yet</p>
                    <% } %>
                </div>
            </div>

            <!-- Mini Gossip Box -->
            <div class="mini-gossip-card-neo">
                <div class="mini-gossip-header">
                    <h3 class="card-title-neo">🗣️ GOSSIP BOX</h3>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <a href="/gossip" class="view-all-gossip" title="View full gossip box">→</a>
                    </div>
                </div>
                
                <div class="mini-gossip-input-section">
                    <textarea id="miniGossipInput" class="mini-gossip-textarea" placeholder="Share a secret..." maxlength="300"></textarea>
                    <div class="mini-gossip-footer">
                        <span id="miniCharCount">0/300</span>
                        <button id="miniPostGossipBtn" class="mini-post-btn" type="button">POST</button>
                    </div>
                </div>

                <div id="miniGossipFeed" class="mini-gossip-feed">
                    <p class="mini-gossip-loading">Loading...</p>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="links-card-neo">
                <h3 class="card-title-neo">⚡ QUICK LINKS</h3>
                <div class="links-list-neo">
                    <a href="/users/campus" class="link-item-neo">
                        <span class="link-icon">👥</span>
                        <span class="link-text">Campus Users</span>
                    </a>
                    <a href="/users/profile" class="link-item-neo">
                        <span class="link-icon">👤</span>
                        <span class="link-text">My Profile</span>
                    </a>
                    <a href="/users/settings/profile" class="link-item-neo">
                        <span class="link-icon">⚙️</span>
                        <span class="link-text">Settings</span>
                    </a>
                    <a href="/gossip" class="link-item-neo <%= currentPath === '/gossip' ? 'active' : '' %>">
                        <span class="link-icon">🗣️</span>
                        <span class="link-text">Gossip Box</span>
                    </a>
                    <a href="/auth/logout" class="link-item-neo logout">
                        <span class="link-icon">🚪</span>
                        <span class="link-text">Logout</span>
                    </a>
<a href="/about" class="link-item-neo about-link <%= currentPath === '/about' ? 'active' : '' %>">
    <span class="link-icon">📘</span>
    <span class="link-text">About</span>
</a>
<a href="/contact" class="link-item-neo <%= currentPath === '/contact' ? 'active' : '' %>">
    <span class="link-icon">📩</span>
    <span class="link-text">CONTACT US</span>
</a>


                </div>
            </div>
        </aside>
    </div>

    <!-- Overlay for mobile panel -->
    <div class="panel-overlay" id="panelOverlay"></div>
</div>

<!-- Inline JavaScript for Quick Interactions -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Like button handled by public/js/posts.js (delegated). Removing inline handler to avoid double POSTs.

    // Comment toggle
    document.querySelectorAll('.comment-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const postCard = this.closest('.post-card-neo');
            const commentSection = postCard.querySelector('.quick-comment-section');
            const isVisible = commentSection.style.display !== 'none';
            commentSection.style.display = isVisible ? 'none' : 'block';

            if (!isVisible) {
                commentSection.querySelector('.quick-comment-input').focus();
            }
        });
    });

    // Quick comment submit handled by public/js/posts.js (delegated). Removing inline reload-based handler.

    // Share button functionality
    document.querySelectorAll('.share-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
            const postId = this.dataset.postId;
            const postUrl = `${window.location.origin}/posts/${postId}`;

            try {
                // Try using Web Share API if available (mobile devices)
                if (navigator.share) {
                    await navigator.share({
                        title: 'Share Post',
                        url: postUrl
                    });
                } else {
                    // Fallback to clipboard copy
                    await navigator.clipboard.writeText(postUrl);

                    // Visual feedback
                    const originalText = this.querySelector('.action-text').textContent;
                    this.querySelector('.action-text').textContent = 'COPIED!';
                    this.style.background = '#FF0000';

                    setTimeout(() => {
                        this.querySelector('.action-text').textContent = originalText;
                        this.style.background = '';
                    }, 2000);
                }
            } catch (error) {
                console.error('Share error:', error);
                alert('Failed to share post');
            }
        });
    });

    // Load more posts
    const loadMoreBtn = document.querySelector('.load-more-btn-neo');
    if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function() {
            const page = this.dataset.page;
            const currentUrl = new URL(window.location.href);
            currentUrl.searchParams.set('page', page);
            window.location.href = currentUrl.toString();
        });
    }
});

// OLD MENU REMOVED - Using mega menu in layout.ejs instead
</script>

<!-- Suggestions and Hover Card Scripts -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Fetch follow suggestions
    (async function loadSuggestions(){
      try {
        const res = await fetch('/users/suggestions');
        const data = await res.json();
        const box = document.getElementById('followSuggestions');
        if (!box) return;
        if (!data.success || !data.results || data.results.length === 0) {
          box.innerHTML = '<p class="trending-empty">No suggestions right now</p>';
          return;
        }
                box.innerHTML = data.results.map(u => {
                    const id = u._id || u.id || u.uuid || '';
                    const username = u.username || u.handle || u.userName || '';
                    const displayName = u.name || u.displayName || u.fullName || '';
                                        const avatarBase = (u.avatarUrl || u.avatar || '/images/default-avatar.png');
                                        const isDicebearAvatar = typeof avatarBase === 'string' && avatarBase.includes('api.dicebear.com');
                                        const avatar = isDicebearAvatar
                                            ? avatarBase
                                            : (avatarBase + (avatarBase.includes('?') ? '&' : '?') + 'v=' + Date.now());
                    const isFollowing = !!(u.isFollowing || u.following || u.followed || false);
                    const btnText = isFollowing ? '✓' : '+';
                    const btnClass = isFollowing ? 'follow-suggest-btn following' : 'follow-suggest-btn';
                    if (!id) {
                        console.warn('No user ID found for suggestion:', u);
                        return '';
                    }
                    return `
                        <div class="suggestion-item">
                            <a href="/users/${username}" class="author-link-neo suggestion-link" data-username="${username}">
                                <img src="${avatar}" alt="@${username}" class="suggestion-avatar" onerror="this.src='/images/default-avatar.png'">
                                <div class="suggestion-info">
                                    <strong class="suggestion-username">@${username}</strong>
                                    <span class="suggestion-name">${displayName}</span>
                                </div>
                            </a>
                            <button class="${btnClass}" data-user-id="${id}" data-username="${username}" data-following="${isFollowing}">${btnText}</button>
                        </div>`
                }).filter(Boolean).join('');
      } catch (e) {
        const box = document.getElementById('followSuggestions');
        if (box) box.innerHTML = '<p class="trending-empty">Failed to load suggestions</p>';
      }
    })();

        // Shared follow button handler
        async function handleFollowClick(btn) {
            const id = btn.getAttribute('data-user-id');
            const isCurrentlyFollowing = btn.getAttribute('data-following') === 'true';
            
            if (!id) {
                console.error('No user ID found on button');
                alert('Unable to follow: missing user ID');
                return;
            }
            
            const action = isCurrentlyFollowing ? 'unfollow' : 'follow';
            console.log(`${action} user:`, id);
            
            try {
                const res = await fetch(`/users/${id}/${action}`, { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' } 
                });
                const data = await res.json();
                console.log('Follow response:', data);
                
                if (!res.ok || !data.success) throw new Error(data.message || 'Failed');
                
                btn.textContent = data.following ? '✓' : '+';
                btn.setAttribute('data-following', data.following);
                btn.classList.toggle('following', data.following);
            } catch (err) {
                console.error('Follow error:', err);
                alert(err.message || 'Failed to update follow');
            }
        }

        // Follow button in suggestions (delegated for left and right panels)
        document.getElementById('quickLinksPanel')?.addEventListener('click', async function(e){
            const btn = e.target.closest('.follow-suggest-btn');
            if (!btn) return;
            await handleFollowClick(btn);
        });

        // Also listen on the left suggestions container
        document.getElementById('followSuggestions')?.addEventListener('click', async function(e){
            const btn = e.target.closest('.follow-suggest-btn');
            if (!btn) return;
            await handleFollowClick(btn);
        });

    // Hover mini card
    const tooltip = document.createElement('div');
    tooltip.id = 'userHoverCard';
    tooltip.style.cssText = 'position:fixed;display:none;background:rgba(10,10,10,0.98);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:12px;z-index:10000;min-width:220px;box-shadow:0 10px 30px rgba(0,0,0,0.4)';
    document.body.appendChild(tooltip);

    let hoverTimer = null;
    let hideTimer = null;

    function positionTooltip(x, y) {
      const margin = 12;
      const width = tooltip.offsetWidth;
      const height = tooltip.offsetHeight;
      let left = x + margin;
      let top = y + margin;
      if (left + width > window.innerWidth) left = x - width - margin;
      if (top + height > window.innerHeight) top = y - height - margin;
      tooltip.style.left = left + 'px';
      tooltip.style.top = top + 'px';
    }

    async function showCard(el, evt) {
      const username = el.getAttribute('data-username');
      if (!username) return;
      positionTooltip(evt.clientX, evt.clientY);
      tooltip.style.display = 'block';
      tooltip.innerHTML = '<div style="color:rgba(255,255,255,0.6);">Loading...</div>';
      try {
        const res = await fetch(`/users/${encodeURIComponent(username)}/card`);
        const data = await res.json();
        if (!data.success) throw new Error('Not found');
        const u = data.user;
                const avatarBase = (u.avatarUrl || '/images/default-avatar.png');
                const isDicebearAvatar = typeof avatarBase === 'string' && avatarBase.includes('api.dicebear.com');
                const avatar = isDicebearAvatar
                    ? avatarBase
                    : (avatarBase + (avatarBase.includes('?') ? '&' : '?') + 'v=' + Date.now());
        tooltip.innerHTML = `
          <div style="display:flex;gap:10px;align-items:center;">
            <img src="${avatar}" style="width:48px;height:48px;border-radius:50%;object-fit:cover;" onerror="this.src='/images/default-avatar.png'">
            <div style="display:flex;flex-direction:column;">
              <strong>@${u.username}</strong>
              <span style="font-size:12px;opacity:0.7;">${u.name || ''}</span>
            </div>
          </div>
          <div style="display:flex;gap:16px;margin-top:8px;font-size:12px;opacity:0.8;">
            <span>Followers: ${u.stats?.followersCount || 0}</span>
            <span>Following: ${u.stats?.followingCount || 0}</span>
          </div>
          <div style="margin-top:10px;">
            <a href="/users/${u.username}" class="profile-action-btn-neo" style="padding:6px 10px;">View Profile →</a>
          </div>`;
      } catch (e) {
        tooltip.innerHTML = '<div style="color:rgba(255,255,255,0.6);">Failed to load</div>';
      }
    }

    function hideCardSoon() {
      hideTimer && clearTimeout(hideTimer);
      hideTimer = setTimeout(() => { tooltip.style.display = 'none'; }, 150);
    }

    document.body.addEventListener('mouseover', function(e){
      const link = e.target.closest('.author-link-neo');
      if (!link) return;
      hoverTimer && clearTimeout(hoverTimer);
      hoverTimer = setTimeout(() => showCard(link, e), 300);
    });
    document.body.addEventListener('mousemove', function(e){
      if (tooltip.style.display === 'block') positionTooltip(e.clientX, e.clientY);
    });
    document.body.addEventListener('mouseout', function(e){
      const link = e.target.closest('.author-link-neo');
      if (!link) return;
      hoverTimer && clearTimeout(hoverTimer);
      hideCardSoon();
    });
    tooltip.addEventListener('mouseenter', () => { hideTimer && clearTimeout(hideTimer); });
    tooltip.addEventListener('mouseleave', hideCardSoon);
  });
</script>

