<%- include('../partials/navbar') %>

<div class="posts-page">
    <div class="feed-container">
        <!-- Main Feed -->
        <main class="feed-container">
            <article class="post-card">
                <!-- Post Header -->
                <header class="post-header">
                    <div class="post-author-info">
                        <%
                        let postAuthorAvatar = post.author.avatarUrl || (post.author.avatarSeed ? ('https://api.dicebear.com/9.x/adventurer/svg?seed=' + post.author.avatarSeed) : '/images/default-avatar.png');
                        const authorCacheKey = post.author.updatedAt ? new Date(post.author.updatedAt).getTime() : '';
                        %>
                        <a href="/users/<%= post.author.username %>" class="post-author-info" style="text-decoration:none;color:inherit;display:flex;align-items:center;gap:12px;">
                          <img src="<%= postAuthorAvatar %><%= authorCacheKey ? ('?v=' + authorCacheKey) : '' %>"
                               alt="<%= post.author.username %>"
                               class="post-author-avatar"
                               onerror="this.src='/images/default-avatar.png'">
                          <div>
                              <span class="post-author-name">@<%= post.author.username %></span>
                              <span class="post-time">
                                  <%= new Date(post.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                              </span>
                          </div>
                        </a>
                    </div>
                    <% if (post.category) { %>
                        <span class="post-category"><%= post.category.toUpperCase() %></span>
                    <% } %>
                </header>

                <!-- Post Content -->
                <div class="post-content">
                    <% if (post.title) { %>
                        <h2 class="post-title"><%= post.title %></h2>
                    <% } %>
                    <% if (post.content) { %>
                        <p class="post-text"><%= post.content %></p>
                    <% } %>

                    <!-- Post Media -->
                    <% if (post.images && post.images.length > 0) { %>
                        <div class="post-media">
                            <% if (post.images[0].url) { %>
                                <img src="<%= post.images[0].url %>"
                                     alt="<%= post.images[0].originalName || 'Post image' %>"
                                     class="post-image"
                                     loading="lazy"
                                     onerror="this.style.display='none'">
                            <% } else if (post.images[0].filename) { %>
                                <img src="/uploads/posts/<%= post.images[0].filename %>"
                                     alt="<%= post.images[0].originalName || 'Post image' %>"
                                     class="post-image"
                                     loading="lazy"
                                     onerror="this.style.display='none'">
                            <% } else if (typeof post.images[0] === 'string') { %>
                                <img src="/uploads/posts/<%= post.images[0] %>"
                                     alt="Post image"
                                     class="post-image"
                                     loading="lazy"
                                     onerror="this.style.display='none'">
                            <% } %>
                        </div>
                    <% } else if (post.media && post.media.length > 0) { %>
                        <% const firstMedia = post.media[0]; %>
                        <% if (firstMedia.type === 'image') { %>
                            <div class="post-media">
                                <img src="<%= firstMedia.url || '/uploads/posts/' + firstMedia.filename %>"
                                     alt="<%= firstMedia.originalName || 'Post image' %>"
                                     class="post-image"
                                     loading="lazy"
                                     onerror="this.style.display='none'">
                            </div>
                        <% } else if (firstMedia.type === 'video') { %>
                            <div class="post-media">
                                <video class="post-video" controls>
                                    <source src="<%= firstMedia.url || '/uploads/posts/' + firstMedia.filename %>"
                                            type="<%= firstMedia.mimetype || 'video/mp4' %>">
                                    Your browser does not support the video tag.
                                </video>
                            </div>
                        <% } %>
                    <% } else if (post.videos && post.videos.length > 0) { %>
                        <div class="post-media">
                            <% if (post.videos[0].url) { %>
                                <video class="post-video" controls>
                                    <source src="<%= post.videos[0].url %>" type="<%= post.videos[0].mimetype || 'video/mp4' %>">
                                    Your browser does not support the video tag.
                                </video>
                            <% } else if (post.videos[0].filename) { %>
                                <video class="post-video" controls>
                                    <source src="/uploads/posts/<%= post.videos[0].filename %>" type="<%= post.videos[0].mimetype || 'video/mp4' %>">
                                    Your browser does not support the video tag.
                                </video>
                            <% } else if (typeof post.videos[0] === 'string') { %>
                                <video class="post-video" controls>
                                    <source src="/uploads/posts/<%= post.videos[0] %>" type="video/mp4">
                                    Your browser does not support the video tag.
                                </video>
                            <% } %>
                        </div>
                    <% } %>

                    <!-- Tags -->
                    <% if (post.tags && post.tags.length > 0) { %>
                        <div class="post-tags">
                            <% post.tags.slice(0, 5).forEach(tag => { %>
                                <span class="post-tag">#<%= tag %></span>
                            <% }); %>
                        </div>
                    <% } %>
                </div>

                <!-- Post Actions -->
                <footer class="post-actions">
                    <button class="action-btn like-btn <%= post.likes && post.likes.includes(user._id.toString()) ? 'liked' : '' %>"
                            data-action="like"
                            data-post-id="<%= post._id %>">
                        <span>❤️</span>
                        <span class="action-count"><%= post.likes ? post.likes.length : 0 %></span>
                    </button>
                    <button class="action-btn comment-btn" data-action="comment">
                        <span>💬</span>
                        <span class="action-count"><%= post.comments ? post.comments.length : 0 %></span>
                    </button>
                    <button class="action-btn share-btn" data-post-id="<%= post._id %>" data-action="share">
                        <span>🔗</span>
                        <span>SHARE</span>
                    </button>
                    <% if (post.author && post.author._id.toString() === user._id.toString()) { %>
                    <button class="action-btn delete-btn" onclick="deletePost('<%= post._id %>')" title="Delete Post">
                        <span>🗑️</span>
                        <span>DELETE</span>
                    </button>
                    <% } %>
                </footer>

                <!-- Comments Section -->
                <div class="comments-section">
                    <div class="comments-list">
                        <% if (post.comments && post.comments.length > 0) { %>
                            <% post.comments.forEach(comment => { %>
                                <% if (comment && comment.author) { %>
                                    <div class="comment-item" data-comment-id="<%= comment._id %>">
                                        <img src="<%= (comment.author.avatarUrl || (comment.author.avatarSeed ? ('https://api.dicebear.com/9.x/adventurer/svg?seed=' + comment.author.avatarSeed) : '/images/default-avatar.png')) %><%= comment.author.updatedAt ? ('?v=' + new Date(comment.author.updatedAt).getTime()) : '' %>"
                                             alt="<%= comment.author.username %>"
                                             class="comment-author-avatar"
                                             onerror="this.src='/images/default-avatar.png'">
                                        <div class="comment-content">
                                            <span class="comment-author">@<%= comment.author.username %></span>
                                            <p><%= comment.content %></p>
                                            <span class="comment-time"><%= new Date(comment.createdAt).toLocaleString() %></span>
                                        </div>
                                        <% if (comment.author._id.toString() === user._id.toString()) { %>
                                            <button class="delete-comment-btn" data-comment-id="<%= comment._id %>" data-post-id="<%= post._id %>" title="Delete comment">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2M10 11v6M14 11v6" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            </button>
                                        <% } %>
                                    </div>
                                <% } %>
                            <% }); %>
                        <% } else { %>
                            <p class="no-comments">No comments yet. Be the first to comment!</p>
                        <% } %>
                    </div>

                    <form class="comment-form" data-post-id="<%= post._id %>">
                        <div class="comment-input">
                            <img src="<%= user.avatarUrl || (user.avatarSeed ? ('https://api.dicebear.com/9.x/adventurer/svg?seed=' + user.avatarSeed) : '/images/default-avatar.png') %><%= user.updatedAt ? ('?v=' + new Date(user.updatedAt).getTime()) : '' %>"
                                 alt="<%= user.username %>"
                                 class="comment-avatar"
                                 onerror="this.src='/images/default-avatar.png'">
                            <input type="text"
                                   class="comment-input"
                                   placeholder="Add a comment..."
                                   required>
                            <button type="submit" class="comment-submit-btn">POST</button>
                        </div>
                    </form>
                </div>
            </article>
        </main>
    </div>
</div>



<script src="/socket.io/socket.io.js"></script>

<%- include('../partials/footer') %>
