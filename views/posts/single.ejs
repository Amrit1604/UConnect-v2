<%- include('../partials/navbar') %>

<div class="single-post-container">
    <a href="/posts" class="back-link">← Back to Feed</a>
    <div class="single-post-wrapper">
        <div class="post-card" data-post-id="<%= post._id %>">
            <div class="post-header">
                <div class="post-author">
                    <div class="author-avatar">
                        <img src="<%= post.author.avatarUrl %>" alt="<%= post.author.username %>">
                    </div>
                    <div class="author-info">
                        <a href="/users/<%= post.author.username ? post.author.username : post.author._id %>" class="author-name">
                            <%= post.author.username %>
                        </a>
                        <span class="post-time"><%= new Date(post.createdAt).toLocaleDateString() %></span>
                    </div>
                </div>
                <div class="post-options">
                    <button class="options-btn">⋮</button>
                </div>
            </div>

            <div class="post-content">
                <p><%= post.content %></p>
                <% if (post.tags && post.tags.length > 0) { %>
                    <div class="post-tags">
                        <% post.tags.forEach(tag => { %>
                            <span class="tag">#<%= tag %></span>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <div class="post-stats">
                <span class="likes-count"><%= post.likeCount || 0 %> likes</span>
                <span class="comments-count"><%= post.commentCount || 0 %> comments</span>
            </div>

            <div class="post-actions">
                <button class="action-btn like-btn" data-post-id="<%= post._id %>">
                    <span>🤍</span>
                    Like
                </button>
                <button class="action-btn comment-btn">
                    <span>💬</span>
                    Comment
                </button>
                <button class="action-btn share-btn">
                    <span>↗️</span>
                    Share
                </button>
                <% if (post.author && post.author._id.toString() === user._id.toString()) { %>
                <button class="action-btn delete-btn" data-post-id="<%= post._id %>" title="Delete Post">
                    <span>🗑️</span>
                    Delete
                </button>
                <% } %>
            </div>

            <!-- Comments Section -->
            <div class="comments-section">
                <div class="comments-list">
                    <% if (post.comments && post.comments.length > 0) { %>
                        <% post.comments.forEach(comment => { %>
                            <div class="comment">
                                <div class="comment-avatar">
                                    <img src="<%= comment.author.avatarUrl %>" alt="<%= comment.author.username %>">
                                </div>
                                <div class="comment-content">
                                    <span class="comment-author username-hover"
                                          data-user-id="<%= comment.author._id %>"
                                          data-username="<%= comment.author.username %>"
                                          data-post-id="<%= post._id %>">
                                        <%= comment.author.username %>
                                    </span>
                                    <span class="comment-text"><%= comment.content %></span>
                                    <span class="comment-time"><%= new Date(comment.createdAt).toLocaleDateString() %></span>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="no-comments">No comments yet. Be the first to comment!</p>
                    <% } %>
                </div>

                <form class="comment-form" action="/posts/<%= post._id %>/comment" method="POST">
                    <div class="comment-input-wrapper">
                        <img src="<%= user.avatarUrl %>" alt="<%= user.username %>" class="comment-avatar">
                        <input type="text" name="content" placeholder="Add a comment..." class="comment-input" required>
                        <button type="submit" class="comment-submit">Post</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
/* Neo Theme for Single Post Page */
.single-post-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
    min-height: 100vh;
}

.single-post-wrapper {
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    overflow: hidden;
}

.post-card {
    padding: 24px;
}

.post-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.post-author {
    display: flex;
    align-items: center;
    gap: 14px;
}

.author-avatar img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255,255,255,0.1);
}

.author-info {
    display: flex;
    flex-direction: column;
}

.author-name {
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    font-size: 16px;
}

.author-name:hover {
    color: #ff4757;
}

.post-time {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
}

.options-btn {
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.6);
    font-size: 20px;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    transition: all 0.2s ease;
}

.options-btn:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
}

.post-content {
    margin-bottom: 20px;
}

.post-content p {
    margin: 0 0 12px 0;
    line-height: 1.6;
    color: rgba(255,255,255,0.9);
    font-size: 15px;
}

.post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
}

.tag {
    background: rgba(255,71,87,0.2);
    color: #ff4757;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    border: 1px solid rgba(255,71,87,0.3);
}

.post-stats {
    display: flex;
    gap: 24px;
    margin-bottom: 16px;
    font-size: 14px;
    color: rgba(255,255,255,0.6);
}

.post-actions {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    flex-wrap: wrap;
}

.action-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 10px 16px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: rgba(255,255,255,0.8);
    transition: all 0.2s ease;
}

.action-btn:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
    transform: translateY(-2px);
}

.action-btn.liked {
    color: #ff4757;
    border-color: rgba(255,71,87,0.3);
    background: rgba(255,71,87,0.1);
}

.action-btn span {
    font-size: 18px;
}

.comments-section {
    margin-top: 24px;
}

.comments-list {
    max-height: 400px;
    overflow-y: auto;
    padding-right: 8px;
}

.comments-list::-webkit-scrollbar {
    width: 6px;
}

.comments-list::-webkit-scrollbar-track {
    background: rgba(255,255,255,0.05);
    border-radius: 3px;
}

.comments-list::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.2);
    border-radius: 3px;
}

.comment {
    display: flex;
    gap: 14px;
    margin-bottom: 16px;
    padding: 12px;
    background: rgba(255,255,255,0.03);
    border-radius: 12px;
    transition: all 0.2s ease;
}

.comment-avatar img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255,255,255,0.1);
}

.comment-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
}

.comment-author {
    font-weight: 700;
    color: #fff;
    font-size: 14px;
    cursor: pointer;
    transition: color 0.2s ease;
}

.comment-author:hover {
    color: #ff4757;
}

.comment-text {
    font-size: 14px;
    color: rgba(255,255,255,0.85);
    line-height: 1.5;
}

.comment-time {
    font-size: 12px;
    color: rgba(255,255,255,0.5);
}

.no-comments {
    text-align: center;
    color: rgba(255,255,255,0.5);
    font-style: italic;
    margin: 24px 0;
    padding: 20px;
    background: rgba(255,255,255,0.03);
    border-radius: 12px;
}

.comment-form {
    margin-top: 20px;
}

.comment-input-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    background: rgba(255,255,255,0.05);
    transition: all 0.2s ease;
}

.comment-input-wrapper:focus-within {
    border-color: rgba(255,71,87,0.5);
    background: rgba(255,255,255,0.08);
}

.comment-input-wrapper img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
}

.comment-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 14px;
    background: transparent;
    color: #fff;
}

.comment-input::placeholder {
    color: rgba(255,255,255,0.5);
}

.comment-submit {
    background: #ff4757;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 20px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    transition: all 0.2s ease;
}

.comment-submit:hover {
    background: #ff6b7a;
    transform: translateY(-2px);
}

/* 🔥 SNEAKY SECRET CHAT STYLES 🔥 */
.username-hover {
    transition: all 0.3s ease;
    border-radius: 4px;
    padding: 2px 4px;
    position: relative;
    display: inline-block;
    cursor: pointer;
}

.username-hover:hover {
    background: rgba(255,71,87,0.15);
    transform: scale(1.02);
}

.comment:hover {
    background: rgba(255,255,255,0.06);
}

/* Delete button style */
.delete-btn {
    color: #ff4757 !important;
    border-color: rgba(255,71,87,0.3) !important;
}
.delete-btn:hover {
    background: rgba(255,71,87,0.15) !important;
    color: #ff6b7a !important;
}

/* Back to feed button */
.back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 16px;
    transition: color 0.2s ease;
}

.back-link:hover {
    color: #ff4757;
}
</style>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/posts.js"></script>

<%- include('../partials/footer') %>
