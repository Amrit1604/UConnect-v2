<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password & Security | UConnect</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="/css/main.css" rel="stylesheet">
    <link href="/css/feed-neo.css" rel="stylesheet">
    <link href="/css/settings-neo.css" rel="stylesheet">
</head>
<body>
    <%- include('../../partials/navbar') %>
    <%- include('../../partials/flash-messages') %>

    <div class="settings-page">
        <div class="parallax-bg">
            <div class="parallax-layer layer-1"></div>
            <div class="parallax-layer layer-2"></div>
            <div class="blob-container">
                <div class="blob blob-1"></div>
                <div class="blob blob-2"></div>
                <div class="blob blob-3"></div>
            </div>
        </div>

        <div class="emoji-reactions">
            <div class="emoji-float emoji-1">🔒</div>
            <div class="emoji-float emoji-2">🔐</div>
            <div class="emoji-float emoji-3">🛡️</div>
            <div class="emoji-float emoji-4">✅</div>
            <div class="emoji-float emoji-5">🔑</div>
            <div class="emoji-float emoji-6">💪</div>
            <div class="emoji-float emoji-7">⚡</div>
        </div>

        <main class="settings-layout-neo">
            <div class="settings-header-neo">
                <h1 class="settings-title-neo">🔒 PASSWORD & SECURITY</h1>
                <p class="settings-subtitle-neo">Keep your account safe and secure</p>
            </div>

            <aside class="settings-sidebar-neo">
                <nav class="settings-nav-neo">
                    <a href="/users/settings/profile" class="settings-nav-item-neo">
                        <span class="settings-nav-icon-neo">👤</span>
                        <span>PROFILE</span>
                    </a>
                    <a href="/users/settings/password" class="settings-nav-item-neo active">
                        <span class="settings-nav-icon-neo">🔒</span>
                        <span>PASSWORD</span>
                    </a>
                    <a href="/users/settings/account" class="settings-nav-item-neo">
                        <span class="settings-nav-icon-neo">🛡️</span>
                        <span>ACCOUNT</span>
                    </a>
                </nav>
            </aside>

            <div class="settings-main-neo">
                <h2 class="section-title-neo">🔐 CHANGE PASSWORD</h2>

                <form method="POST" action="/users/settings/password" id="passwordForm">
                    <div class="form-group-neo">
                        <label for="currentPassword" class="form-label-neo">CURRENT PASSWORD</label>
                        <input type="password" id="currentPassword" name="currentPassword" class="form-input-neo" required>
                    </div>

                    <div class="form-group-neo">
                        <label for="newPassword" class="form-label-neo">NEW PASSWORD</label>
                        <input type="password" id="newPassword" name="newPassword" class="form-input-neo" required>
                        <small class="form-help-neo">Must be at least 8 characters with uppercase, lowercase, number, and special character</small>
                    </div>

                    <div class="form-group-neo">
                        <label for="confirmPassword" class="form-label-neo">CONFIRM NEW PASSWORD</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-input-neo" required>
                    </div>

                    <button type="submit" class="btn-primary-neo btn-neo">
                        🔐 UPDATE PASSWORD
                    </button>
                </form>

                <div class="privacy-section-neo" style="margin-top: 40px;">
                    <h3 class="privacy-title-neo">🛡️ SECURITY TIPS</h3>
                    <p style="color: rgba(255, 255, 255, 0.7); font-size: 14px; line-height: 1.8;">
                        • Use a unique password that you don't use anywhere else<br>
                        • Include a mix of letters, numbers, and special characters<br>
                        • Avoid using personal information like your name or birthdate<br>
                        • Never share your password with anyone
                    </p>
                </div>
            </div>
        </main>
    </div>

    <%- include('../../partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>
