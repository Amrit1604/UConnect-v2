<div class="requests-page">
  <div class="requests-header">
    <h1>Friend Requests</h1>
    <p>Manage your incoming friend requests</p>
  </div>

  <% if (receivedRequests && receivedRequests.length > 0) { %>
    <div class="requests-list">
      <% receivedRequests.forEach(r => { %>
        <% if (!r.sender) return; %>
        <div class="request-item">
          <div class="request-content">
            <div class="request-icon">👤</div>
            <div class="request-text">
              <div class="request-title">@<%= r.sender.username %> sent you a friend request</div>
              <div class="request-message"><%= r.message || 'No message provided' %></div>
              <div class="request-time"><%= new Date(r.createdAt).toLocaleString() %></div>
            </div>
          </div>
          <div class="request-actions">
            <div class="follow-actions">
              <button class="accept-btn" data-id="<%= r._id %>">Accept</button>
              <button class="reject-btn" data-id="<%= r._id %>">Reject</button>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">👥</div>
      <h3>No friend requests</h3>
      <p>When someone sends you a friend request, it'll appear here</p>
    </div>
  <% } %>

  <% if (sentRequests && sentRequests.length > 0) { %>
    <div class="sent-requests-section">
      <h2>Sent Requests</h2>
      <div class="requests-list">
        <% sentRequests.forEach(r => { %>
          <% if (!r.receiver) return; %>
          <div class="request-item sent">
            <div class="request-content">
              <div class="request-icon">📤</div>
              <div class="request-text">
                <div class="request-title">Request sent to @<%= r.receiver.username %></div>
                <div class="request-message"><%= r.message || 'No message provided' %></div>
                <div class="request-time"><%= new Date(r.createdAt).toLocaleString() %></div>
              </div>
            </div>
            <div class="request-status">
              <span class="status-pending">Pending</span>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>

<script>
  window.__USER_ID__ = '<%= user ? user._id : '' %>';

  (function(){
    document.querySelectorAll('.accept-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        try {
          const res = await fetch(`/chat/request/${id}/accept`, { method: 'POST' });
          if (res.ok) {
            location.reload();
          } else {
            alert('Failed to accept request');
          }
        } catch (error) {
          alert('Error accepting request');
        }
      });
    });

    document.querySelectorAll('.reject-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        try {
          const res = await fetch(`/chat/request/${id}/reject`, { method: 'POST' });
          if (res.ok) {
            location.reload();
          } else {
            alert('Failed to reject request');
          }
        } catch (error) {
          alert('Error rejecting request');
        }
      });
    });
  })();
</script>
