<style>
/* ===== INSTAGRAM-STYLE CHAT ===== */
*, *::before, *::after { box-sizing: border-box; }

.ig-chat-wrap {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 64px);
  max-width: 760px;
  margin: 0 auto;
  background: #000;
  position: relative;
}

/* Header */
.ig-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  background: rgba(0,0,0,0.95);
  backdrop-filter: blur(12px);
  position: sticky;
  top: 0;
  z-index: 10;
  flex-shrink: 0;
}
.ig-back {
  color: #fff;
  text-decoration: none;
  font-size: 20px;
  padding: 4px 8px;
  border-radius: 8px;
  transition: background 0.2s;
}
.ig-back:hover { background: rgba(255,255,255,0.08); }
.ig-header-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid #e63946;
}
.ig-header-info { flex: 1; }
.ig-header-name { font-weight: 700; font-size: 15px; color: #fff; }
.ig-header-status { font-size: 12px; color: rgba(255,255,255,0.45); margin-top: 1px; }
.ig-header-status.online { color: #4ade80; }

/* Messages scroll area */
.ig-messages {
  flex: 1;
  overflow-y: auto;
  padding: 16px 16px 8px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  scroll-behavior: smooth;
}
.ig-messages::-webkit-scrollbar { width: 4px; }
.ig-messages::-webkit-scrollbar-track { background: transparent; }
.ig-messages::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }

/* Empty state */
.ig-empty {
  text-align: center;
  margin: auto;
  color: rgba(255,255,255,0.3);
  font-size: 15px;
  padding: 40px 20px;
}
.ig-empty-icon { font-size: 48px; margin-bottom: 12px; }

/* Message row */
.ig-msg-row {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  max-width: 75%;
  animation: msgIn 0.2s ease;
}
@keyframes msgIn { from { opacity:0; transform: translateY(6px); } to { opacity:1; transform: translateY(0); } }
.ig-msg-row.sent { align-self: flex-end; flex-direction: row-reverse; }
.ig-msg-row.received { align-self: flex-start; }

.ig-row-avatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  margin-bottom: 2px;
}
.ig-row-avatar.hidden { visibility: hidden; }

/* Bubble */
.ig-bubble {
  padding: 10px 14px;
  border-radius: 18px;
  font-size: 15px;
  line-height: 1.4;
  max-width: 100%;
  word-break: break-word;
  position: relative;
}
.sent .ig-bubble {
  background: #2b7cff;
  color: #fff;
  border-bottom-right-radius: 4px;
}
.received .ig-bubble {
  background: rgba(255,255,255,0.1);
  color: #fff;
  border-bottom-left-radius: 4px;
}

/* Image bubble */
.ig-bubble.img-bubble {
  padding: 3px;
  background: transparent !important;
}
.ig-chat-img {
  max-width: 220px;
  max-height: 280px;
  width: 100%;
  border-radius: 16px;
  object-fit: cover;
  display: block;
  cursor: pointer;
  transition: opacity 0.2s;
}
.ig-chat-img:hover { opacity: 0.9; }

/* File bubble */
.ig-file-bubble {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: inherit;
}
.ig-file-icon { font-size: 26px; }
.ig-file-name { font-size: 13px; font-weight: 600; }
.ig-file-size { font-size: 11px; opacity: 0.65; }

/* Timestamp + status row */
.ig-msg-meta {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  color: rgba(255,255,255,0.35);
  margin-top: 3px;
  padding: 0 4px;
}
.sent .ig-msg-meta { justify-content: flex-end; }
.ig-tick { font-size: 12px; }
.ig-tick.read { color: #2b7cff; }

/* Typing */
.ig-typing {
  display: none;
  align-self: flex-start;
  padding: 10px 14px;
  background: rgba(255,255,255,0.1);
  border-radius: 18px;
  border-bottom-left-radius: 4px;
  margin-bottom: 4px;
}
.ig-typing.active { display: flex; gap: 4px; align-items: center; }
.ig-dot {
  width: 7px; height: 7px;
  background: rgba(255,255,255,0.5);
  border-radius: 50%;
  animation: dotBounce 1.2s infinite;
}
.ig-dot:nth-child(2) { animation-delay: 0.2s; }
.ig-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotBounce { 0%,60%,100% { transform: translateY(0); } 30% { transform: translateY(-5px); } }

/* Input area */
.ig-input-area {
  padding: 10px 12px;
  border-top: 1px solid rgba(255,255,255,0.08);
  background: rgba(0,0,0,0.95);
  backdrop-filter: blur(12px);
  flex-shrink: 0;
}
.ig-input-row {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.07);
  border-radius: 24px;
  padding: 8px 12px;
  border: 1px solid rgba(255,255,255,0.1);
  transition: border-color 0.2s;
}
.ig-input-row:focus-within { border-color: rgba(255,255,255,0.25); }
.ig-input-btn {
  background: none;
  border: none;
  color: rgba(255,255,255,0.5);
  cursor: pointer;
  font-size: 20px;
  padding: 2px;
  line-height: 1;
  transition: color 0.2s;
  flex-shrink: 0;
}
.ig-input-btn:hover { color: #fff; }
.ig-text-input {
  flex: 1;
  background: none;
  border: none;
  outline: none;
  color: #fff;
  font-size: 15px;
  font-family: inherit;
  min-width: 0;
}
.ig-text-input::placeholder { color: rgba(255,255,255,0.35); }
.ig-send-btn {
  background: none;
  border: none;
  color: #2b7cff;
  font-weight: 700;
  font-size: 15px;
  cursor: pointer;
  padding: 2px 6px;
  flex-shrink: 0;
  transition: opacity 0.2s;
}
.ig-send-btn:disabled { opacity: 0.35; cursor: default; }

/* Lightbox */
#igLightbox {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.92);
  z-index: 9999;
  align-items: center;
  justify-content: center;
  cursor: zoom-out;
}
#igLightbox.open { display: flex; }
#igLightbox img {
  max-width: 92vw;
  max-height: 92vh;
  object-fit: contain;
  border-radius: 8px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.8);
}
#igLightboxClose {
  position: fixed;
  top: 16px;
  right: 20px;
  color: #fff;
  font-size: 28px;
  cursor: pointer;
  background: none;
  border: none;
  line-height: 1;
  z-index: 10000;
}

/* Date divider */
.ig-date-divider {
  text-align: center;
  font-size: 12px;
  color: rgba(255,255,255,0.3);
  margin: 10px 0 6px;
  position: relative;
}
</style>

<!-- Lightbox -->
<div id="igLightbox">
  <button id="igLightboxClose">✕</button>
  <img id="igLightboxImg" src="" alt="Image">
</div>

<% 
  let headerAvatar = '/images/default-avatar.png';
  if (otherUser.avatarType === 'supabase' && otherUser.avatarSupabaseUrl) {
    headerAvatar = otherUser.avatarSupabaseUrl;
  } else if (otherUser.avatarUrl) {
    headerAvatar = otherUser.avatarUrl;
  } else if (otherUser.avatarSeed) {
    headerAvatar = 'https://api.dicebear.com/9.x/adventurer/svg?seed=' + otherUser.avatarSeed;
  }
%>

<div class="ig-chat-wrap">
  <!-- Header -->
  <div class="ig-header">
    <a href="/chat" class="ig-back">←</a>
    <img src="<%= headerAvatar %>" class="ig-header-avatar" onerror="this.src='/images/default-avatar.png'" alt="">
    <div class="ig-header-info">
      <div class="ig-header-name"><%= otherUser.username %></div>
      <div class="ig-header-status" id="igStatus">Offline</div>
    </div>
  </div>

  <!-- Messages -->
  <div class="ig-messages" id="igMessages">
    <% if (!messages || messages.length === 0) { %>
      <div class="ig-empty">
        <div class="ig-empty-icon">💬</div>
        No messages yet. Say hi! 👋
      </div>
    <% } %>

    <% 
      let lastDateStr = '';
      messages && messages.forEach((m, i) => {
        const isMe = m.sender && m.sender._id && m.sender._id.toString() === user._id.toString();
        const isDeleted = m.deletedBy && m.deletedBy.some(id => id.toString() === user._id.toString());
        if (isDeleted) return;

        const msgDate = new Date(m.sentAt);
        const dateStr = msgDate.toLocaleDateString([], { month:'short', day:'numeric' });
        const timeStr = msgDate.toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' });

        const nextMsg = messages[i + 1];
        const nextSame = nextMsg && nextMsg.sender && nextMsg.sender._id &&
          nextMsg.sender._id.toString() === (m.sender && m.sender._id && m.sender._id.toString());
        const showAvatar = !isMe && !nextSame;

        let otherAvatarStr = '/images/default-avatar.png';
        if (otherUser.avatarType === 'supabase' && otherUser.avatarSupabaseUrl) otherAvatarStr = otherUser.avatarSupabaseUrl;
        else if (otherUser.avatarUrl) otherAvatarStr = otherUser.avatarUrl;
        else if (otherUser.avatarSeed) otherAvatarStr = 'https://api.dicebear.com/9.x/adventurer/svg?seed=' + otherUser.avatarSeed;
    %>
      <% if (dateStr !== lastDateStr) { lastDateStr = dateStr; %>
        <div class="ig-date-divider"><%= dateStr %></div>
      <% } %>

      <div class="ig-msg-row <%= isMe ? 'sent' : 'received' %>" data-msg-id="<%= m._id %>">
        <% if (!isMe) { %>
          <img src="<%= otherAvatarStr %>" class="ig-row-avatar <%= showAvatar ? '' : 'hidden' %>" onerror="this.src='/images/default-avatar.png'" alt="">
        <% } %>

        <div>
          <% if (m.messageType === 'image' && m.fileGridFSId) { %>
            <div class="ig-bubble img-bubble">
              <img
                src="/gridfs/<%= m.fileGridFSId %>"
                class="ig-chat-img"
                data-src="/gridfs/<%= m.fileGridFSId %>"
                alt="Image"
                onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
              >
              <div style="display:none;padding:10px;color:rgba(255,255,255,0.5);font-size:13px;">📷 Image</div>
              <% if (m.content) { %><div class="ig-bubble" style="margin-top:4px"><%= m.content %></div><% } %>
            </div>
          <% } else if (m.messageType === 'file' && m.fileGridFSId) { %>
            <%
              let fileIcon = '📄';
              if (m.fileName) {
                const ext = m.fileName.split('.').pop().toLowerCase();
                if (ext === 'pdf') fileIcon = '📕';
                else if (ext === 'doc' || ext === 'docx') fileIcon = '📘';
                else if (['xls','xlsx'].includes(ext)) fileIcon = '📗';
                else if (['zip','rar'].includes(ext)) fileIcon = '📦';
                else if (ext === 'txt') fileIcon = '📝';
              }
            %>
            <div class="ig-bubble">
              <a href="/gridfs/<%= m.fileGridFSId %>" download="<%= m.fileName %>" class="ig-file-bubble">
                <span class="ig-file-icon"><%= fileIcon %></span>
                <div>
                  <div class="ig-file-name"><%= m.fileName || 'File' %></div>
                  <div class="ig-file-size"><%= m.fileSize ? (m.fileSize/1024).toFixed(1) + ' KB' : '' %></div>
                </div>
              </a>
            </div>
          <% } else { %>
            <div class="ig-bubble"><%= m.content %></div>
          <% } %>

          <div class="ig-msg-meta">
            <span><%= timeStr %></span>
            <% if (isMe) { %>
              <span class="ig-tick <%= m.isRead ? 'read' : '' %>"><%= m.isRead ? '✓✓' : (m.isDelivered ? '✓✓' : '✓') %></span>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>

    <!-- Typing indicator -->
    <div class="ig-typing" id="igTyping">
      <span class="ig-dot"></span>
      <span class="ig-dot"></span>
      <span class="ig-dot"></span>
    </div>
  </div>

  <!-- Input -->
  <div class="ig-input-area">
    <div class="ig-input-row">
      <input type="file" id="igFileInput" class="media-input" accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.txt,.zip" style="display:none">
      <button type="button" class="ig-input-btn" id="igAttachBtn" title="Attach">📎</button>
      <input type="text" class="ig-text-input" id="igInput" placeholder="Message..." autocomplete="off" maxlength="2000">
      <button type="button" class="ig-send-btn" id="igSendBtn">Send</button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  'use strict';

  const ME_ID     = '<%= user._id %>';
  const OTHER_ID  = '<%= otherUser._id %>';
  const OTHER_UN  = '<%= otherUser.username %>';
  const OTHER_AV  = '<%= headerAvatar %>';

  const messagesEl = document.getElementById('igMessages');
  const inputEl    = document.getElementById('igInput');
  const sendBtn    = document.getElementById('igSendBtn');
  const attachBtn  = document.getElementById('igAttachBtn');
  const fileInput  = document.getElementById('igFileInput');
  const typingEl   = document.getElementById('igTyping');
  const statusEl   = document.getElementById('igStatus');
  const lightbox   = document.getElementById('igLightbox');
  const lbImg      = document.getElementById('igLightboxImg');
  const lbClose    = document.getElementById('igLightboxClose');

  /* ---- Lightbox ---- */
  document.addEventListener('click', function (e) {
    const img = e.target.closest('.ig-chat-img');
    if (!img) return;
    lbImg.src = img.dataset.src || img.src;
    lightbox.classList.add('open');
  });
  lightbox.addEventListener('click', () => lightbox.classList.remove('open'));
  lbClose.addEventListener('click', () => lightbox.classList.remove('open'));

  /* ---- Scroll ---- */
  function scrollBottom(smooth) {
    messagesEl.scrollTo({ top: messagesEl.scrollHeight, behavior: smooth ? 'smooth' : 'auto' });
  }
  scrollBottom(false);

  /* ---- Build bubble HTML ---- */
  function buildBubble(msg, isSent) {
    const time = new Date(msg.sentAt || Date.now())
      .toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    const tick = isSent
      ? `<span class="ig-tick ${msg.isRead ? 'read' : ''}">${msg.isRead ? '✓✓' : (msg.isDelivered ? '✓✓' : '✓')}</span>`
      : '';
    const meta = `<div class="ig-msg-meta"><span>${time}</span>${tick}</div>`;

    let inner = '';
    if (msg.messageType === 'image' && msg.fileGridFSId) {
      inner = `<div class="ig-bubble img-bubble">
        <img src="/gridfs/${msg.fileGridFSId}" data-src="/gridfs/${msg.fileGridFSId}"
             class="ig-chat-img" alt="Image"
             onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
        <div style="display:none;padding:10px;color:rgba(255,255,255,0.5);font-size:13px;">📷 Image</div>
        ${msg.content ? `<div class="ig-bubble" style="margin-top:4px">${esc(msg.content)}</div>` : ''}
      </div>`;
    } else if (msg.messageType === 'file' && msg.fileGridFSId) {
      const ext = (msg.fileName || '').split('.').pop().toLowerCase();
      const icon = {pdf:'📕',doc:'📘',docx:'📘',xls:'📗',xlsx:'📗',zip:'📦',rar:'📦',txt:'📝'}[ext] || '📄';
      const sizeKB = msg.fileSize ? (msg.fileSize / 1024).toFixed(1) + ' KB' : '';
      inner = `<div class="ig-bubble">
        <a href="/gridfs/${msg.fileGridFSId}" download="${esc(msg.fileName || 'file')}" class="ig-file-bubble">
          <span class="ig-file-icon">${icon}</span>
          <div><div class="ig-file-name">${esc(msg.fileName || 'File')}</div><div class="ig-file-size">${sizeKB}</div></div>
        </a>
      </div>`;
    } else {
      inner = `<div class="ig-bubble">${esc(String(msg.content || ''))}</div>`;
    }

    const avatarHtml = !isSent
      ? `<img src="${OTHER_AV}" class="ig-row-avatar" onerror="this.src='/images/default-avatar.png'" alt="">`
      : '';

    const row = document.createElement('div');
    row.className = `ig-msg-row ${isSent ? 'sent' : 'received'}`;
    if (msg._id) row.dataset.msgId = msg._id;
    row.innerHTML = avatarHtml + `<div>${inner}${meta}</div>`;
    return row;
  }

  function appendMessage(msg, isSent) {
    const empty = messagesEl.querySelector('.ig-empty');
    if (empty) empty.remove();
    // Insert before typing indicator
    messagesEl.insertBefore(buildBubble(msg, isSent), typingEl);
    scrollBottom(true);
  }

  function esc(str) {
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  /* ---- Socket.IO ---- */
  if (typeof io === 'undefined') { console.error('Socket.IO not loaded'); return; }
  const socket = io();

  socket.on('connect', function () {
    socket.emit('authenticate', ME_ID);
    socket.emit('join_conversation', { userId: ME_ID, otherUserId: OTHER_ID });
  });

  /* Real-time: incoming message from the OTHER user */
  socket.on('new_message', function (data) {
    const msg  = data.message || data;
    const from = msg.sender && (msg.sender._id || msg.sender);
    if (String(from) !== String(OTHER_ID)) return; // ignore own echoes
    appendMessage(msg, false);
    // send read receipt immediately (chat is open)
    socket.emit('messages_read', { userId: ME_ID, otherUserId: OTHER_ID });
  });

  socket.on('user_online',  d => { if (d.userId === OTHER_ID) { statusEl.textContent = 'Active now'; statusEl.className = 'ig-header-status online'; } });
  socket.on('user_offline', d => { if (d.userId === OTHER_ID) { statusEl.textContent = 'Offline'; statusEl.className = 'ig-header-status'; } });

  socket.on('user_typing', function (d) {
    if (d.userId !== OTHER_ID) return;
    typingEl.classList.toggle('active', !!d.isTyping);
    if (d.isTyping) scrollBottom(true);
  });

  socket.on('messages_read_receipt', function () {
    messagesEl.querySelectorAll('.ig-msg-row.sent .ig-tick').forEach(el => {
      el.className = 'ig-tick read';
      el.textContent = '✓✓';
    });
  });

  socket.on('message_delivered', function (d) {
    const row = messagesEl.querySelector(`[data-msg-id="${d.messageId}"]`);
    if (row) { const t = row.querySelector('.ig-tick'); if (t) t.textContent = '✓✓'; }
  });

  socket.on('message_deleted', function (d) {
    const row = messagesEl.querySelector(`[data-msg-id="${d.messageId}"]`);
    if (row) { row.style.opacity = '0'; setTimeout(() => row.remove(), 200); }
  });

  /* ---- Typing emit ---- */
  let typingTimer;
  inputEl.addEventListener('input', function () {
    socket.emit('typing_start', { userId: ME_ID, otherUserId: OTHER_ID });
    clearTimeout(typingTimer);
    typingTimer = setTimeout(() => socket.emit('typing_stop', { userId: ME_ID, otherUserId: OTHER_ID }), 1500);
    sendBtn.disabled = !inputEl.value.trim();
  });
  sendBtn.disabled = true;

  /* ---- Send text ---- */
  function sendText() {
    const content = inputEl.value.trim();
    if (!content) return;
    inputEl.value = '';
    sendBtn.disabled = true;
    socket.emit('typing_stop', { userId: ME_ID, otherUserId: OTHER_ID });

    // Optimistic bubble
    const tmpMsg = { content, sentAt: new Date(), messageType: 'text', isDelivered: false, isRead: false };
    const tmpRow = buildBubble(tmpMsg, true);
    tmpRow.style.opacity = '0.6';
    messagesEl.insertBefore(tmpRow, typingEl);
    scrollBottom(true);

    fetch('/chat/' + OTHER_ID + '/message', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ content })
    })
    .then(r => r.json())
    .then(data => {
      if (data.success && data.message) {
        tmpRow.style.opacity = '1';
        if (data.message._id) tmpRow.dataset.msgId = data.message._id;
      } else {
        tmpRow.remove();
        inputEl.value = content;
      }
    })
    .catch(() => {
      tmpRow.remove();
      inputEl.value = content;
    });
  }

  sendBtn.addEventListener('click', sendText);
  inputEl.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendText(); }
  });

  /* ---- Attach file ---- */
  attachBtn.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', function () {
    const file = fileInput.files[0];
    if (!file) return;
    if (file.size > 25 * 1024 * 1024) { alert('Max 25MB'); fileInput.value = ''; return; }

    const fd = new FormData();
    fd.append('file', file);

    // Show uploading state
    const uploadRow = document.createElement('div');
    uploadRow.className = 'ig-msg-row sent';
    uploadRow.innerHTML = '<div><div class="ig-bubble" style="opacity:.5">Uploading…</div></div>';
    messagesEl.insertBefore(uploadRow, typingEl);
    scrollBottom(true);

    fetch('/chat/' + OTHER_ID + '/upload', {
      method: 'POST',
      credentials: 'same-origin',
      body: fd
    })
    .then(r => r.json())
    .then(data => {
      uploadRow.remove();
      if (data.success && data.message) {
        appendMessage(data.message, true);
      } else {
        alert('Upload failed');
      }
    })
    .catch(() => { uploadRow.remove(); alert('Upload failed'); });

    fileInput.value = '';
  });

  /* ---- Mark read on open ---- */
  setTimeout(() => socket.emit('messages_read', { userId: ME_ID, otherUserId: OTHER_ID }), 600);
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) socket.emit('messages_read', { userId: ME_ID, otherUserId: OTHER_ID });
  });

  });
</script>
