<link rel="stylesheet" href="/css/chat-neo.css">
<div class="chat-window chat-conversation" data-other-id="<%= otherUser._id %>">
  <div class="chat-header">
    <div style="display:flex;align-items:center;gap:10px">
      <a href="/chat" class="back-btn" style="color:white;text-decoration:none;font-size:20px;margin-right:5px;display:none;">←</a>
        <%
        const avatarUrl = otherUser.avatarUrl || otherUser.avatarSupabaseUrl || '/images/default-avatar.png';
        %>
        <img src="<%= avatarUrl %>" style="width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,0.1);">
      <div>
        <div class="title" style="font-weight:bold;font-size:16px;"><%= otherUser.name || otherUser.username %></div>
        <span id="presenceBadge" class="presence-badge offline" style="font-size:10px;padding:2px 8px;">Offline</span>
      </div>
    </div>
  </div>

  <div id="conversationMessages" class="chat-messages" role="log" aria-live="polite">
    <% if (messages && messages.length) { %>
      <% messages.forEach(m => { %>
        <% const isMe = (m.sender && m.sender._id && m.sender._id.toString() === user._id.toString()); %>
        <div class="msg <%= isMe ? 'msg--sent' : 'msg--received' %>" data-msg-id="<%= m._id %>">
          <div class="bubble">
            <div class="bubble-meta">
              <span class="bubble-username"><%= m.sender && m.sender.username ? (isMe ? 'You' : m.sender.username) : '' %></span>
              <span class="bubble-time"><%= new Date(m.sentAt).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) %></span>
              <span class="read-receipt" style="float:right;"></span>
            </div>
            <div class="bubble-content"><%= m.content %></div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="chat-empty" style="text-align:center;padding:40px 20px;color:rgba(255,255,255,0.5);">
        <div style="font-size:48px;margin-bottom:12px;">💬</div>
        <div style="font-size:16px;">No messages yet</div>
        <div style="font-size:14px;margin-top:8px;">Send a message to start the conversation</div>
      </div>
    <% } %>
  </div>

  <div class="chat-typing" id="typingIndicator" aria-hidden="true" style="display: none; opacity: 0;">
    <div class="typing-indicator" aria-hidden="true">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
    </div>
  </div>

  <div class="chat-input">
    <form id="chatSendForm">
      <input type="text" id="chatMessageInput" class="chat-text-input" placeholder="Type a message..." autocomplete="off" aria-label="Message input" />
      <button type="submit" class="send-btn">Send</button>
    </form>
  </div>

  <script>
    window.__USER_ID__ = '<%= user ? user._id : '' %>';
    // Auto-join conversation and wire UI
    (function(){
      const otherId = '<%= otherUser._id %>';
      if (window.chatJoinConversation) window.chatJoinConversation(otherId);

      const form = document.getElementById('chatSendForm');
      const input = document.getElementById('chatMessageInput');
      const backBtn = document.querySelector('.back-btn');

      // Show back button on mobile
      if (window.innerWidth <= 768) {
        backBtn.style.display = 'inline-flex';
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const text = input.value.trim();
        if (!text) return;
        try {
          await window.chatSendMessage(otherId, text);
          input.value = '';
          // Stop typing indicator when sending
          if (window.chatTyping) window.chatTyping(otherId, false);
        } catch (err) {
          alert('Failed to send');
        }
      });

      // Debounced typing indicator
      let typingTimeout = null;
      input.addEventListener('input', () => {
        if (window.chatTyping) {
          window.chatTyping(otherId, true);
        }
      });

      // Scroll to bottom on load
      const msgs = document.getElementById('conversationMessages');
      if (msgs) {
        msgs.scrollTop = msgs.scrollHeight;
      }

      // Focus input after delay for mobile
      setTimeout(() => {
        input.focus();
      }, 500);

      // Auto-scroll on keyboard open
      input.addEventListener('focus', () => {
        setTimeout(() => {
          if (msgs) {
            msgs.scrollTo({
              top: msgs.scrollHeight,
              behavior: 'smooth'
            });
          }
        }, 300);
      });
    })();
  </script>
</div>
