<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | UConnect</title>

    <!-- Meta tags for SEO -->
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Connect with your campus community. Share, discover, and engage with fellow students.' %>">
    <meta name="keywords" content="campus, students, social media, university, college, community">
    <meta name="author" content="UConnect">

    <!-- Open Graph tags -->
    <meta property="og:title" content="<%= title %> | UConnect">
    <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Connect with your campus community' %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= typeof url !== 'undefined' ? url : '' %>">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">

    <!-- CSS -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Open+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="/css/main.css" rel="stylesheet">
    <link href="/css/landing-neo.css" rel="stylesheet">
    <link href="/css/admin.css" rel="stylesheet">
    <link id="brutalist-theme" href="/css/brutalist.css" rel="stylesheet" disabled>

    <!-- Additional page-specific CSS -->
    <% if (typeof additionalCSS !== 'undefined') { %>
        <% additionalCSS.forEach(css => { %>
            <link href="<%= css %>" rel="stylesheet">
        <% }) %>
    <% } %>
</head>
<body class="<%= (typeof bodyClass !== 'undefined' ? bodyClass : '') + (isAdminSession ? ' admin-mode' : '') %>">
    <!-- Navigation (hide in admin mode) -->
    <% if (!isAdminSession) { %>
    <nav class="navbar-neo">
        <div class="nav-container-neo">
            <!-- Left: Logo -->
            <div class="nav-brand-neo">
                <a href="/" class="brand-link-neo">
                    <div class="logo-brutalist">U</div>
                    <span class="brand-text">CONNECT</span>
                </a>
            </div>

            <% if (user) { %>
                <!-- Center: Navigation Links + Search -->
                <div class="nav-center-neo">
                    <a href="/posts" class="nav-link-neo <%= currentPath === '/posts' ? 'active' : '' %>">FEED</a>
                    <a href="/posts/create" class="nav-link-neo <%= currentPath === '/posts/create' ? 'active' : '' %>">CREATE</a>
                    <a href="/users/campus" class="nav-link-neo <%= currentPath === '/users/campus' ? 'active' : '' %>">CAMPUS</a>
                    <a href="/users/explore" class="nav-link-neo <%= currentPath === '/users/explore' ? 'active' : '' %>">EXPLORE</a>
                    <!-- User Search -->
                    <div class="nav-search-neo" style="position: relative; margin-left: 16px;">
                        <input type="text" id="userSearchInput" placeholder="Search users" aria-label="Search users" class="nav-search-input" style="padding:8px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.2);background:rgba(0,0,0,0.3);color:#fff;min-width:220px;">
                        <div id="userSearchResults" class="nav-search-results" style="position:absolute;top:42px;left:0;right:0;background:rgba(10,10,10,0.98);border:1px solid rgba(255,255,255,0.1);border-radius:10px;overflow:hidden;display:none;z-index:1000;"></div>
                    </div>
                </div>

                <!-- Right: Action Buttons -->
                <div class="nav-actions-neo">
                    <!-- Notifications bell -->
                    <a href="/notifications" class="nav-link-neo" style="position:relative;margin-right:8px" id="navNotificationsLink">
                      🔔 <span id="navNotificationsCount" style="background:#ff4d4f;color:#fff;border-radius:999px;padding:2px 6px;font-size:12px;margin-left:6px;display:none">0</span>
                    </a>
                    <!-- Theme Toggle Button -->
                    <button class="theme-toggle-btn" id="themeToggle" aria-label="Toggle theme">
                        <span class="theme-icon moon">🌙</span>
                        <span class="theme-icon sun">☀️</span>
                    </button>

                    <!-- User Avatar -->
                    <a href="/users/profile" class="nav-avatar-link">
                        <%
                          const navAvatarUrl = (user && user.avatarUrl) ? user.avatarUrl : (user && user.avatarSeed ? 'https://api.dicebear.com/9.x/adventurer/svg?seed=' + user.avatarSeed : '/images/default-avatar.png');
                          const navAvatarVer = user && user.updatedAt ? new Date(user.updatedAt).getTime() : Date.now();
                        %>
                        <img src="<%= navAvatarUrl %>?v=<%= navAvatarVer %>"
                             alt="<%= user && (user.name || user.username) %>"
                             class="nav-avatar"
                             onerror="this.src='/images/default-avatar.png'">
                    </a>
                </div>

                <!-- Mobile Menu Button -->
                <button class="mobile-menu-btn-neo" aria-label="Toggle menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            <% } else { %>
                <!-- Center: Navigation Links (Guest) -->
                <div class="nav-center-neo">
                    <a href="/" class="nav-link-neo">HOME</a>
                    <a href="#features" class="nav-link-neo">FEATURES</a>
                    <a href="#about" class="nav-link-neo">ABOUT</a>
                </div>

                <!-- Right: Action Buttons (Guest) -->
                <div class="nav-actions-neo">
                    <button class="theme-toggle-btn" id="themeToggle" aria-label="Toggle theme">
                        <span class="theme-icon moon">🌙</span>
                        <span class="theme-icon sun">☀️</span>
                    </button>
                    <a href="/auth/login" class="nav-btn-ghost">SIGN IN</a>
                    <a href="/auth/register" class="nav-btn-primary magnetic-btn">JOIN NOW</a>
                </div>

                <!-- Mobile Menu Button -->
                <button class="mobile-menu-btn-neo" aria-label="Toggle menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            <% } %>
        </div>
    </nav>
    <% } %>

    <!-- Flash Messages -->
    <% if (messages && (messages.success || messages.error || messages.warning || messages.info)) { %>
        <div class="flash-messages">
            <% if (messages.success) { %>
                <% messages.success.forEach(message => { %>
                    <div class="flash-message flash-success">
                        <i class="fas fa-check-circle"></i>
                        <span><%= message %></span>
                        <button class="flash-close" type="button" aria-label="Dismiss message">
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                    </div>
                <% }) %>
            <% } %>

            <% if (messages.error) { %>
                <% messages.error.forEach(message => { %>
                    <div class="flash-message flash-error">
                        <i class="fas fa-exclamation-circle"></i>
                        <span><%= message %></span>
                        <button class="flash-close" type="button" aria-label="Dismiss message">
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                    </div>
                <% }) %>
            <% } %>

            <% if (messages.warning) { %>
                <% messages.warning.forEach(message => { %>
                    <div class="flash-message flash-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span><%= message %></span>
                        <button class="flash-close" type="button" aria-label="Dismiss message">
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                    </div>
                <% }) %>
            <% } %>

            <% if (messages.info) { %>
                <% messages.info.forEach(message => { %>
                    <div class="flash-message flash-info">
                        <i class="fas fa-info-circle"></i>
                        <span><%= message %></span>
                        <button class="flash-close" type="button" aria-label="Dismiss message">
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                    </div>
                <% }) %>
            <% } %>
        </div>
    <% } %>

    <!-- Main Content -->
    <main class="main-content">
        <%- include(bodyTemplate || 'partials/default-body') %>
    </main>

    <!-- JavaScript -->
    <script src="/js/main.js"></script>
    <script src="/js/landing-neo.js"></script>
    <script src="/js/admin.js"></script>
    <script src="/socket.io/socket.io.js"></script>

    <script>
      // Debounced user search in navbar
      (function(){
        const input = document.getElementById('userSearchInput');
        const results = document.getElementById('userSearchResults');
        if (!input || !results) return;

        let t = null;
        const render = (items) => {
          if (!items || items.length === 0) {
            results.innerHTML = '<div style="padding:10px;color:rgba(255,255,255,0.6);">No users found</div>';
            results.style.display = 'block';
            return;
          }
          results.innerHTML = items.map(u => {
            const avatar = (u.avatarUrl || '/images/default-avatar.png') + '?v=' + Date.now();
            const name = u.name || u.username;
            return `
              <a href="/users/${u.username}" class="search-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;color:#fff;text-decoration:none;border-bottom:1px solid rgba(255,255,255,0.06);">
                <img src="${avatar}" alt="@${u.username}" style="width:28px;height:28px;border-radius:50%;object-fit:cover;" onerror="this.src='/images/default-avatar.png'">
                <div style="display:flex;flex-direction:column;line-height:1.1;">
                  <span style="font-weight:600;">@${u.username}</span>
                  <span style="font-size:12px;color:rgba(255,255,255,0.6);">${name}</span>
                </div>
              </a>`
          }).join('');
          results.style.display = 'block';
        };

        const search = async (q) => {
          try {
            const res = await fetch(`/users/search?q=${encodeURIComponent(q)}`);
            const data = await res.json();
            if (data && data.success) render(data.results);
          } catch (e) {
            console.warn('Search failed');
          }
        };

        input.addEventListener('input', function(){
          const q = input.value.trim();
          clearTimeout(t);
          if (!q) { results.style.display = 'none'; results.innerHTML=''; return; }
          t = setTimeout(() => search(q), 250);
        });

        document.addEventListener('click', function(e){
          if (!results.contains(e.target) && e.target !== input) {
            results.style.display = 'none';
          }
        });
      })();
    </script>

    <!-- Global Socket.IO realtime handlers -->
    <script>
      (function(){
        if (!(window.io)) return; // socket.io not present on some pages
        const socket = io();

        // Realtime follow/unfollow updates
        socket.on('user:follow_update', (payload) => {
          try {
            const pageRoot = document.querySelector('[data-profile-user-id]');
            const followersEl = document.getElementById('followersCount');
            if (pageRoot && followersEl) {
              const profileId = pageRoot.getAttribute('data-profile-user-id');
              if (profileId && (payload.targetId === profileId)) {
                followersEl.textContent = payload.followersCount;
              }
            }
          } catch (_) {}
        });

        // Realtime likes updates on feed
        socket.on('post-liked', (data) => {
          try {
            const card = document.querySelector(`[data-post-id="${data.postId}"]`);
            if (!card) return;
            const likeBtn = card.querySelector('.like-btn');
            const countSpan = likeBtn && likeBtn.querySelector('.action-count');
            if (countSpan) countSpan.textContent = data.likes; // update only count
            // Do NOT toggle liked class here; the actor's client updates locally.
          } catch (_) {}
        });

        // Realtime new comments
        socket.on('new-comment', (data) => {
          try {
            const card = document.querySelector(`[data-post-id="${data.postId}"]`);
            if (!card) return;
            // Update comment count on the action bar
            const countSpan = card.querySelector('.comment-btn .action-count, .comment-btn span');
            if (countSpan) {
              const n = parseInt(countSpan.textContent || '0', 10) || 0;
              countSpan.textContent = n + 1;
            }
            // Append to quick comments list if present
            const list = card.querySelector('.quick-comments-list');
            if (list && data.comment) {
              const c = data.comment;
              const avatar = (c.author && c.author.avatarUrl) ? c.author.avatarUrl : '/images/default-avatar.png';
              const wrapper = document.createElement('div');
              wrapper.className = 'quick-comment-item';
              wrapper.innerHTML = `
                <a href="/users/${c.author.username}" class="author-link-neo" data-username="${c.author.username}" style="display:inline-flex;align-items:center;gap:8px;text-decoration:none;color:inherit;">
                  <img src="${avatar}" alt="${c.author.username}" class="quick-comment-avatar" onerror="this.src='/images/default-avatar.png'">
                </a>
                <div class="quick-comment-content">
                  <a href="/users/${c.author.username}" class="author-link-neo" data-username="${c.author.username}" style="font-weight:600;color:inherit;text-decoration:none;">@${c.author.username}</a>
                  <p></p>
                </div>`;
              const p = wrapper.querySelector('p');
              if (p) p.textContent = c.content || '';
              list.prepend(wrapper);
            }
          } catch (_) {}
        });
      })();
    </script>

    <!-- Additional page-specific JavaScript -->
    <% if (typeof additionalJS !== 'undefined') { %>
        <% additionalJS.forEach(js => { %>
            <script src="<%= js %>"></script>
        <% }) %>
    <% } %>

    <%- include('partials/admin-modal') %>

</body>
</html>