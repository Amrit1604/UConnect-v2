    <script>
      // Debounced user search in navbar
      (function(){
        const input = document.getElementById('userSearchInput');
        const results = document.getElementById('userSearchResults');
        if (!input || !results) return;

        let t = null;
        const render = (items) => {
          if (!items || items.length === 0) {
            results.innerHTML = '<div style="padding:10px;color:rgba(255,255,255,0.6);">No users found</div>';
            results.style.display = 'block';
            return;
          }
                    results.innerHTML = items.map(u => {
                                                const baseAvatar = (u.avatarUrl || '/images/default-avatar.png');
                                                const isDicebearAvatar = typeof baseAvatar === 'string' && baseAvatar.includes('api.dicebear.com');
                                                const avatar = isDicebearAvatar
                                                    ? baseAvatar
                                                    : (baseAvatar + (baseAvatar.includes('?') ? '&' : '?') + 'v=' + Date.now());
            const name = u.name || u.username;
            return `
              <a href="/users/${u.username}" class="search-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;color:#fff;text-decoration:none;border-bottom:1px solid rgba(255,255,255,0.06);">
                <img src="${avatar}" alt="@${u.username}" style="width:28px;height:28px;border-radius:50%;object-fit:cover;">
                <div style="display:flex;flex-direction:column;line-height:1.1;">
                  <span style="font-weight:600;">@${u.username}</span>
                  <span style="font-size:12px;color:rgba(255,255,255,0.6);">${name}</span>
                </div>
              </a>`
          }).join('');
          results.style.display = 'block';
        };

        const search = async (q) => {
          try {
            const res = await fetch(`/users/search?q=${encodeURIComponent(q)}`);
            const data = await res.json();
            if (data && data.success) render(data.results);
          } catch (e) {
            console.warn('Search failed');
          }
        };

        input.addEventListener('input', function(){
          const q = input.value.trim();
          clearTimeout(t);
          if (!q) { results.style.display = 'none'; results.innerHTML=''; return; }
          t = setTimeout(() => search(q), 250);
        });

        document.addEventListener('click', function(e){
          if (!results.contains(e.target) && e.target !== input) {
            results.style.display = 'none';
          }
        });
      })();
    </script>

    <!-- Global Socket.IO realtime handlers -->
    <script>
      (function(){
        if (!(window.io)) return; // socket.io not present on some pages
        const socket = io();

        // Realtime follow/unfollow updates
        socket.on('user:follow_update', (payload) => {
          try {
            const pageRoot = document.querySelector('[data-profile-user-id]');
            const followersEl = document.getElementById('followersCount');
            if (pageRoot && followersEl) {
              const profileId = pageRoot.getAttribute('data-profile-user-id');
              if (profileId && (payload.targetId === profileId)) {
                followersEl.textContent = payload.followersCount;
              }
            }
          } catch (_) {}
        });

        // Realtime likes updates on feed
        socket.on('post-liked', (data) => {
          try {
            const card = document.querySelector(`[data-post-id="${data.postId}"]`);
            if (!card) return;
            const likeBtn = card.querySelector('.like-btn');
            const countSpan = likeBtn && likeBtn.querySelector('.action-count');
            if (countSpan) countSpan.textContent = data.likes; // update only count
            // Do NOT toggle liked class here; the actor's client updates locally.
          } catch (_) {}
        });

        // Realtime new comments
        socket.on('new-comment', (data) => {
          try {
            const card = document.querySelector(`[data-post-id="${data.postId}"]`);
            if (!card) return;
            
            // Skip if the comment author is the current user (they already see it locally)
            const currentUsername = '<%= user ? user.username : "" %>';
            if (data.comment && data.comment.author && data.comment.author.username === currentUsername) {
              // Still update the count though (the local add doesn't bump it)
              const countSpan = card.querySelector('.comment-btn .action-count, .comment-btn span');
              if (countSpan) {
                const n = parseInt(countSpan.textContent || '0', 10) || 0;
                countSpan.textContent = n + 1;
              }
              return;
            }
            
            // Update comment count on the action bar
            const countSpan = card.querySelector('.comment-btn .action-count, .comment-btn span');
            if (countSpan) {
              const n = parseInt(countSpan.textContent || '0', 10) || 0;
              countSpan.textContent = n + 1;
            }
            // Append to quick comments list if present
            const list = card.querySelector('.quick-comments-list');
            if (list && data.comment) {
              const c = data.comment;
              const avatar = (c.author && c.author.avatarUrl) ? c.author.avatarUrl : '/images/default-avatar.png';
              const wrapper = document.createElement('div');
              wrapper.className = 'quick-comment-item';
              wrapper.innerHTML = `
                <a href="/users/${c.author.username}" class="author-link-neo" data-username="${c.author.username}" style="display:inline-flex;align-items:center;gap:8px;text-decoration:none;color:inherit;">
                  <img src="${avatar}" alt="${c.author.username}" class="quick-comment-avatar">
                </a>
                <div class="quick-comment-content">
                  <a href="/users/${c.author.username}" class="author-link-neo" data-username="${c.author.username}" style="font-weight:600;color:inherit;text-decoration:none;">@${c.author.username}</a>
                  <p></p>
                </div>`;
              const p = wrapper.querySelector('p');
              if (p) p.textContent = c.content || '';
              list.prepend(wrapper);
            }
          } catch (_) {}
        });
      })();
    </script>

